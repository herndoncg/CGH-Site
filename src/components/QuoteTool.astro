---
// The instant quote: three short steps, then a price range.
// Job details -> ground conditions -> contact info -> range shown and lead sent.
// The price is worked out on the server (netlify/functions/lib/quote.mjs). No prices or formulas are in this page.
// Two ways through: Simple (size and ground) and Detailed (more areas, rock depth, what is there now, access, timing).
import { site } from '../data/site';
---
<form class="qt" name="quote" method="POST" data-netlify="true" netlify-honeypot="bot-field" data-quote-tool data-phone={site.phone} data-endpoint={site.formEndpoint} novalidate>
  <input type="hidden" name="form-name" value="quote" />
  {['loads', 'est_low', 'est_high', 'premium_range', 'elite_range', 'details', 'page', 'source', 'submitted_at'].map((n) => <input type="hidden" name={n} />)}
  <ol class="qt__steps" aria-hidden="true">
    <li class="is-on">The job</li><li>The ground</li><li>Your info</li><li>Your price</li>
  </ol>

  <fieldset class="qt__panel is-on" data-step="1">
    <div class="qt__mode" role="radiogroup" aria-label="How much detail">
      <label><input type="radio" name="mode" value="simple" checked /><span><b>Simple</b> Size and ground. About a minute.</span></label>
      <label><input type="radio" name="mode" value="advanced" /><span><b>Detailed</b> More areas, rock depth, access, timing.</span></label>
    </div>
    <legend>What are we paving?</legend>
    <div class="chips" role="radiogroup" aria-label="Type of job">
      <label><input type="radio" name="job_type" value="Driveway" checked /><span>Driveway</span></label>
      <label><input type="radio" name="job_type" value="Parking lot" /><span>Parking lot</span></label>
      <label><input type="radio" name="job_type" value="Private or ranch road" /><span>Private or ranch road</span></label>
      <label><input type="radio" name="job_type" value="Something else" /><span>Something else</span></label>
    </div>

    <p class="qt__q">How big is it?</p>
    <div class="qt__size">
      <div class="field"><label for="qt-len">Length (feet)</label><input id="qt-len" name="length_ft" inputmode="decimal" placeholder="100" /></div>
      <span class="qt__x" aria-hidden="true">×</span>
      <div class="field"><label for="qt-wid">Width (feet)</label><input id="qt-wid" name="width_ft" inputmode="decimal" placeholder="12" /></div>
      <span class="qt__or">or</span>
      <div class="field"><label for="qt-sqft">Total square feet</label><input id="qt-sqft" name="sqft" inputmode="numeric" placeholder="1,200" /></div>
    </div>
    <p class="qt__hint">No tape measure? Pace it off. One long step is about 3 feet. A close guess is fine.</p>
    <div data-adv hidden>
      <p class="qt__q">More than one area? Add them here and we total it.</p>
      <div class="qt__size">
        <div class="field"><label for="qt-l2">Second area, length (feet)</label><input id="qt-l2" name="l2" inputmode="decimal" /></div>
        <span class="qt__x" aria-hidden="true">×</span>
        <div class="field"><label for="qt-w2">Width (feet)</label><input id="qt-w2" name="w2" inputmode="decimal" /></div>
      </div>
      <div class="qt__size">
        <div class="field"><label for="qt-l3">Third area, length (feet)</label><input id="qt-l3" name="l3" inputmode="decimal" /></div>
        <span class="qt__x" aria-hidden="true">×</span>
        <div class="field"><label for="qt-w3">Width (feet)</label><input id="qt-w3" name="w3" inputmode="decimal" /></div>
      </div>
      <p class="qt__fill" data-total aria-live="polite"></p>
      <div class="field"><label for="qt-existing">What is there now?</label><select id="qt-existing" name="existing"><option>Dirt or grass</option><option>Gravel or rock</option><option>Old asphalt</option><option>Concrete</option></select></div>
    </div>
    <p class="qt__err" data-err="1" role="alert"></p>
    <div class="qt__nav"><span></span><button type="button" class="btn btn--paver" data-next>Next: the ground</button></div>
  </fieldset>

  <fieldset class="qt__panel" data-step="2">
    <legend>What shape is the ground in?</legend>
    <p class="qt__q">Any washouts, ruts or low spots that need grading before we pave?</p>
    <div class="chips" role="radiogroup" aria-label="Needs grading">
      <label><input type="radio" name="base_work" value="No" checked /><span>No, it is in decent shape</span></label>
      <label><input type="radio" name="base_work" value="Yes" /><span>Yes, it needs work</span></label>
      <label><input type="radio" name="base_work" value="Not sure" /><span>Not sure</span></label>
    </div>

    <p class="qt__q"><label for="qt-fill">About how much of the area needs rock brought in?</label></p>
    <input id="qt-fill" class="qt__range" type="range" name="fill_pct" min="0" max="100" step="5" value="0" />
    <p class="qt__fill" data-fill-label aria-live="polite">None. The ground is already solid.</p>
    <p class="qt__hint">Think soft spots, thin gravel or bare dirt. If you are not sure, leave it at none and we will check on the site visit.</p>
    <div data-adv hidden>
      <div class="form-grid">
        <div class="field"><label for="qt-rock">How much rock, and what will drive on it?</label><select id="qt-rock" name="rock_depth"><option value="2">A top-up, about 2 inches</option><option value="4">New base for cars, about 4 inches</option><option value="6">New base for delivery trucks, about 6 inches</option><option value="8">New base for heavy trucks and RVs, about 8 inches</option></select></div>
        <div class="field"><label for="qt-time">When do you want it done?</label><select id="qt-time" name="timeline"><option>As soon as you can</option><option>This month</option><option>In the next few months</option><option>Just pricing it for now</option></select></div>
        <div class="field"><label for="qt-access">Anything tight for trucks? (gates, low limbs, septic lines)</label><input id="qt-access" name="access" /></div>
        <div class="field"><label for="qt-stripe">Need parking stripes?</label><select id="qt-stripe" name="striping"><option>No</option><option>Yes</option></select></div>
      </div>
    </div>
    <div class="qt__nav"><button type="button" class="btn btn--line" data-back>Back</button><button type="button" class="btn btn--paver" data-next>Next: your info</button></div>
  </fieldset>

  <fieldset class="qt__panel" data-step="3">
    <legend>Where should we send your price?</legend>
    <div class="hp" aria-hidden="true"><label>Leave blank<input type="text" name="bot-field" tabindex="-1" autocomplete="off" /></label></div>
    <div class="form-grid">
      <div class="field"><label for="qt-name">Name</label><input id="qt-name" name="name" autocomplete="name" required /></div>
      <div class="field"><label for="qt-phone">Phone</label><input id="qt-phone" name="phone" type="tel" autocomplete="tel" required /></div>
      <div class="field"><label for="qt-email">Email (optional)</label><input id="qt-email" name="email" type="email" autocomplete="email" /></div>
      <div class="field"><label for="qt-city">Job address or town</label><input id="qt-city" name="city" autocomplete="street-address" placeholder="Longview, TX" /></div>
    </div>
    <p class="qt__err" data-err="3" role="alert"></p>
    <div class="qt__nav"><button type="button" class="btn btn--line" data-back>Back</button><button type="submit" class="btn btn--paver">Show my price range</button></div>
    <p class="legal">By continuing, you agree CGH Operations may call, text or email you about this request. See our <a href="/privacy">privacy policy</a>.</p>
  </fieldset>

  <div class="qt__panel qt__result" data-step="4" tabindex="-1">
    <p class="qt__label" data-out="head">Working out your price…</p>
    <div class="qt__opts" data-out="opts"></div>
    <ul class="qt__inc" data-out="inc"></ul>
    <p class="qt__note">These are ballparks from what you entered, before taxes or permits. We confirm the final price with a free site visit before any work starts.</p>
    <p class="qt__sent" data-out="sent"></p>
    <div class="qt__next" data-next-step>
      <p class="qt__nexthead">What would you like to do next?</p>
      <div class="chips" role="radiogroup" aria-label="Next step">
        <label><input type="radio" name="want" value="visit" checked /><span>Book my free site visit</span></label>
        <label><input type="radio" name="want" value="call" /><span>Call me about it</span></label>
      </div>
      <div class="form-grid">
        <div class="field"><label for="qt-lean">Which one are you leaning toward?</label><select id="qt-lean" name="lean"><option>Not sure yet</option><option>Economy</option><option>Premium</option><option>Elite</option></select></div>
        <div class="field"><label for="qt-when">Best time to reach you</label><select id="qt-when" name="when"><option>Any time</option><option>Morning</option><option>Afternoon</option><option>Evening</option></select></div>
        <div class="field"><label for="qt-note">Anything we should know? (optional)</label><input id="qt-note" name="want_note" /></div>
      </div>
      <button type="button" class="btn btn--paver" data-request>Send my request</button>
      <p class="qt__err" data-err="4" role="alert"></p>
    </div>
    <p class="qt__done" data-out="requested" role="status"></p>
    <div class="btn-row">
      <a class="btn btn--line" href={site.phoneHref}>Or call {site.phone} now</a>
      <a class="btn btn--line" data-mailquote href="#" hidden>Email me this quote</a>
      <button type="button" class="btn btn--line" data-print>Print or save</button>
      <button type="button" class="btn btn--line" data-restart>Change my numbers</button>
    </div>
  </div>
</form>
{/* A second copy of the "book a visit / call me" request goes through Netlify Forms, so it also lands in the same inbox as the quote. */}
<form name="quote-request" method="POST" data-netlify="true" netlify-honeypot="bot-field" hidden>
  {['bot-field', 'name', 'phone', 'wants', 'best_time', 'note', 'price_range', 'job'].map((n) => <input name={n} />)}
</form>

<script>
  const money = (n: number) => '$' + Math.round(n).toLocaleString('en-US');

  const num = (v: FormDataEntryValue | null) => parseFloat(String(v ?? '').replace(/[^0-9.]/g, '')) || 0;
  const fillWords = (p: number) =>
    p === 0 ? 'None. The ground is already solid.'
    : p <= 15 ? `About ${p}%. A few soft spots.`
    : p <= 35 ? `About ${p}%. Roughly a quarter of it.`
    : p <= 60 ? `About ${p}%. Around half.`
    : p < 100 ? `About ${p}%. Most of it.`
    : 'All of it.';

  document.querySelectorAll<HTMLFormElement>('[data-quote-tool]').forEach((form) => {
    const panels = [...form.querySelectorAll<HTMLElement>('.qt__panel')];
    const steps = [...form.querySelectorAll<HTMLElement>('.qt__steps li')];
    const el = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const err = (n: number, msg: string) => { const e = form.querySelector<HTMLElement>(`[data-err="${n}"]`); if (e) e.textContent = msg; };

    const show = (n: number) => {
      panels.forEach((p) => p.classList.toggle('is-on', p.dataset.step === String(n)));
      steps.forEach((s, i) => { s.classList.toggle('is-on', i + 1 === n); s.classList.toggle('is-done', i + 1 < n); });
      const panel = panels[n - 1];
      (panel.querySelector('input:not([type=radio]):not([tabindex="-1"])') as HTMLElement | null ?? panel).focus({ preventScroll: true });
      const top = form.getBoundingClientRect().top;
      if (top < 0) window.scrollBy({ top: top - 90, behavior: 'smooth' });
    };

    const advanced = () => (form.elements.namedItem('mode') as RadioNodeList).value === 'advanced';
    const syncMode = () => { form.querySelectorAll<HTMLElement>('[data-adv]').forEach((e) => (e.hidden = !advanced())); const t = form.querySelector<HTMLElement>('[data-total]')!; t.textContent = advanced() && sqft() ? `Total: ${Math.round(sqft()).toLocaleString('en-US')} sq ft` : ''; };
    const sqft = () => {
      const direct = num(el('sqft').value);
      const first = direct > 0 ? direct : num(el('length_ft').value) * num(el('width_ft').value);
      return advanced() ? first + num(el('l2').value) * num(el('w2').value) + num(el('l3').value) * num(el('w3').value) : first;
    };

    // Typing length and width fills the square feet box; typing square feet clears the other two.
    ['length_ft', 'width_ft'].forEach((n) => el(n).addEventListener('input', () => {
      const a = num(el('length_ft').value) * num(el('width_ft').value);
      el('sqft').value = a > 0 ? Math.round(a).toLocaleString('en-US') : '';
    }));
    el('sqft').addEventListener('input', () => { el('length_ft').value = ''; el('width_ft').value = ''; });

    const fill = el('fill_pct'), fillLabel = form.querySelector<HTMLElement>('[data-fill-label]')!;
    fill.addEventListener('input', () => { fillLabel.textContent = fillWords(Number(fill.value)); });

    // Arriving from the homepage with ?sqft=1200 (or length & width) prefilled.
    const q = new URLSearchParams(location.search);
    if (q.get('length')) el('length_ft').value = q.get('length')!;
    if (q.get('width')) el('width_ft').value = q.get('width')!;
    if (num(q.get('length')) * num(q.get('width')) > 0) el('sqft').value = Math.round(num(q.get('length')) * num(q.get('width'))).toLocaleString('en-US');
    else if (q.get('sqft')) el('sqft').value = q.get('sqft')!;

    // Keeps what was typed if the page is refreshed or the phone switches apps (this tab only, never sent anywhere).
    const KEEP = ['mode', 'job_type', 'length_ft', 'width_ft', 'sqft', 'l2', 'w2', 'l3', 'w3', 'existing', 'base_work', 'fill_pct', 'rock_depth', 'timeline', 'access', 'striping', 'name', 'phone', 'email', 'city'];
    const remember = () => { try { const d = new FormData(form); sessionStorage.setItem('cgh-quote', JSON.stringify(Object.fromEntries(KEEP.map((k) => [k, d.get(k)])))); } catch {} };
    try {
      const saved = JSON.parse(sessionStorage.getItem('cgh-quote') || 'null');
      if (saved && !q.get('length') && !q.get('sqft')) for (const k of KEEP) { const v = saved[k]; if (v == null || v === '') continue; const node = form.elements.namedItem(k); if (node instanceof RadioNodeList) node.value = String(v); else if (node) (node as HTMLInputElement).value = String(v); }
      fillLabel.textContent = fillWords(Number(fill.value));
    } catch {}
    form.addEventListener('input', () => { remember(); syncMode(); }); form.addEventListener('change', () => { remember(); syncMode(); }); syncMode();
    // Phone numbers tidy themselves as they are typed: (903) 555-0100
    el('phone').addEventListener('input', () => { const d = el('phone').value.replace(/\D/g, '').replace(/^1(?=\d{10})/, '').slice(0, 10); el('phone').value = d.length > 6 ? `(${d.slice(0, 3)}) ${d.slice(3, 6)}-${d.slice(6)}` : d.length > 3 ? `(${d.slice(0, 3)}) ${d.slice(3)}` : d; });
    form.querySelector('[data-print]')!.addEventListener('click', () => window.print());
    // Where this visitor came from, so the team can see what is bringing in work.
    const cameFrom = () => { const u = new URLSearchParams(location.search).get('utm_source'); if (u) return u.slice(0, 40); try { const h = document.referrer ? new URL(document.referrer).hostname.replace(/^www\./, '') : ''; return h && h !== location.hostname ? h : 'came straight to the site'; } catch { return ''; } };

    form.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest('button');
      if (!t) return;
      const current = Number(panels.find((p) => p.classList.contains('is-on'))!.dataset.step);
      if (t.hasAttribute('data-next')) {
        if (current === 1) {
          const a = sqft();
          if (a < 50) return err(1, 'Enter a length and width, or the total square feet, so we can price it.');
          err(1, '');
        }
        show(current + 1);
      } else if (t.hasAttribute('data-back')) show(current - 1);
      else if (t.hasAttribute('data-restart')) show(1);
    });

    // After the price: "book my site visit" or "call me". Goes straight to the CGH team as an alert.
    let leadSent: Promise<{ ref?: string }> = Promise.resolve({});
    form.querySelector('[data-request]')!.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement; const d = new FormData(form);
      btn.disabled = true; btn.textContent = 'Sending…'; err(4, '');
      try {
        const { ref } = await leadSent; if (!ref) throw new Error('no ref');
        const r = await fetch('/api/lead-request', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ ref, want: d.get('want'), when: d.get('when'), note: d.get('want_note'), option: d.get('lean') }) });
        if (!r.ok) throw new Error(String(r.status));
        if (form.dataset.endpoint) fetch(form.dataset.endpoint, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ 'form-name': 'quote-request', name: String(d.get('name')), phone: String(d.get('phone')), wants: d.get('want') === 'call' ? 'A phone call' : 'A free site visit', best_time: String(d.get('when')), note: String(d.get('want_note') || ''), price_range: [...form.querySelectorAll('.qt__opt')].map((o) => `${o.querySelector('.qt__optname')!.textContent} ${o.querySelector('.qt__price')!.textContent}`).join('; ') + (d.get('lean') && d.get('lean') !== 'Not sure yet' ? `. Leaning ${d.get('lean')}` : ''), job: `${d.get('job_type')}, ${sqft().toLocaleString('en-US')} sq ft` }).toString() }).catch(() => {});
        form.querySelector<HTMLElement>('[data-next-step]')!.hidden = true;
        form.querySelector<HTMLElement>('[data-out="requested"]')!.textContent = d.get('want') === 'call' ? `Got it. We will call you at ${d.get('phone')}.` : `Got it. We will call ${d.get('phone')} to set up your free site visit.`;
      } catch { err(4, 'That did not send. Please call us and mention your price range.'); }
      btn.disabled = false; btn.textContent = 'Send my request';
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      if (data.get('bot-field')) return; // spam bot
      const name = String(data.get('name') || '').trim();
      const phone = String(data.get('phone') || '').replace(/\D/g, '');
      if (!name || phone.length < 10) return err(3, 'Add your name and a 10-digit phone number so we can follow up on your price.');
      err(3, '');

      const out = (k: string) => form.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
      const payload: Record<string, string> = {
        'form-name': 'quote', name, phone: String(data.get('phone')), email: String(data.get('email') || ''), city: String(data.get('city') || ''),
        job_type: String(data.get('job_type')), length_ft: String(data.get('length_ft') || ''), width_ft: String(data.get('width_ft') || ''), sqft: String(Math.round(sqft())), base_work: String(data.get('base_work')), fill_pct: String(data.get('fill_pct')),
        mode: advanced() ? 'advanced' : 'simple', page: location.pathname, source: cameFrom(), submitted_at: new Date().toISOString(),
      };
      if (advanced()) Object.assign(payload, { rock_depth: String(data.get('rock_depth')), existing: String(data.get('existing')), access: String(data.get('access') || ''), timeline: String(data.get('timeline')), striping: String(data.get('striping')), areas: [[data.get('length_ft'), data.get('width_ft')], [data.get('l2'), data.get('w2')], [data.get('l3'), data.get('w3')]].filter(([a, b]) => num(a) * num(b) > 0).map(([a, b]) => `${a} x ${b}`).join(', ') });
      out('head').textContent = 'Working out your price…'; out('opts').replaceChildren(); out('inc').replaceChildren(); out('sent').textContent = ''; out('requested').textContent = '';
      form.querySelector<HTMLElement>('[data-next-step]')!.hidden = true;
      const mail = form.querySelector<HTMLAnchorElement>('[data-mailquote]')!; mail.hidden = true;
      show(4);

      // The server prices it and saves the lead in one step. Nothing about the pricing is in this page.
      leadSent = fetch('/api/lead', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) }).then(async (r) => ({ ...(await r.json().catch(() => ({}))), status: r.status })).catch(() => ({}));
      const res: any = await leadSent; const q = res.quote;
      if (!q) {
        out('head').textContent = res.status === 429 ? 'That is a lot of quotes in one hour.' : 'We could not work out the price just now.';
        out('sent').textContent = res.status === 429 ? `Call ${form.dataset.phone} and we will price it with you.` : `Call ${form.dataset.phone} and we will price it with you, or try again in a minute.`;
      } else {
        out('head').textContent = `Three ways to do your ${q.sqft.toLocaleString('en-US')} sq ft`;
        out('opts').replaceChildren(...q.options.map((o: any) => { const d = document.createElement('div'); d.className = 'qt__opt'; const add = (tag: string, cls: string, text: string) => { const e = document.createElement(tag); e.className = cls; e.textContent = text; d.append(e); }; add('p', 'qt__optname', o.name); add('p', 'qt__price', `${money(o.low)} to ${money(o.high)}`); add('p', 'qt__optwhat', o.what + '.'); add('p', 'qt__optlasts', o.lasts + '.'); return d; }));
        out('inc').replaceChildren(...[...q.includes.map((t: string) => 'Included: ' + t), ...q.flags].map((t: string) => { const li = document.createElement('li'); li.textContent = t; return li; }));
        form.querySelector<HTMLElement>('[data-next-step]')!.hidden = false;
        const mine = String(data.get('email') || '').trim(); mail.hidden = !mine;
        if (mine) mail.href = `mailto:${mine.replace(/[?&\s]/g, '')}?subject=${encodeURIComponent('My CGH Operations price range')}&body=${encodeURIComponent(`CGH Operations price ranges for about ${q.sqft.toLocaleString('en-US')} sq ft:\n\n${q.options.map((o: any) => `${o.name}: ${money(o.low)} to ${money(o.high)}. ${o.what}.`).join('\n')}\n\nThese are ballparks before a free site visit. Call ${form.dataset.phone || ''} with questions.\n${location.origin}/quote`)}`;
        Object.assign(payload, { loads: String(q.loads), est_low: String(q.options[0].low), est_high: String(q.options[0].high), premium_range: `${money(q.options[1].low)} to ${money(q.options[1].high)}`, elite_range: `${money(q.options[2].low)} to ${money(q.options[2].high)}`, details: [...q.includes, ...q.flags].join(' | ') });
        try { sessionStorage.removeItem('cgh-quote'); } catch {}
      }
      // A copy also goes through Netlify Forms, so it reaches the same inbox even if the app is down.
      const endpoint = form.dataset.endpoint; if (!endpoint) return;
      try {
        const r = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams(payload).toString() });
        if (!r.ok) throw new Error(String(r.status));
        if (q) out('sent').textContent = `Thanks, ${name.split(' ')[0]}. Your price ranges are saved with our team.`;
        else out('sent').textContent += ' We have your details and will call you.';
      } catch { if (q) out('sent').textContent = ''; }
    });
  });
</script>

<style>
  .qt { background: var(--surface); color: var(--text); border-radius: var(--radius-lg); padding: clamp(20px, 3.4vw, 40px); box-shadow: 0 24px 70px rgba(11, 18, 32, 0.18); border: 1px solid var(--border); }
  .qt__steps { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; padding: 0; margin: 0 0 28px; font-size: 0.86rem; font-weight: 600; color: var(--muted); }
  .qt__steps li { border-top: 5px solid var(--limestone-2); padding-top: 8px; }
  .qt__steps li.is-on { border-color: var(--paver); color: var(--text); }
  .qt__steps li.is-done { border-color: var(--asphalt); }
  .qt__panel { display: none; border: 0; padding: 0; margin: 0; min-width: 0; }
  .qt__panel.is-on { display: block; }
  .qt__panel:focus { outline: none; }
