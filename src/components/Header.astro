---
import { site, workPhotos } from '../data/site';
const path = Astro.url.pathname;
const links = [
  { href: '/services', label: 'Services' },
  { href: '/service-areas', label: 'Service areas' },
  ...(workPhotos.length ? [{ href: '/work', label: 'Our work' }] : []),
  { href: '/about', label: 'About' },
  { href: '/careers', label: 'Careers' },
  { href: '/blog', label: 'Blog' },
];
// Shortcuts in the phone menu, so the common jobs are one tap away.
const quick = [
  { href: '/services/asphalt-driveways', label: 'Driveways' },
  { href: '/services/parking-lots', label: 'Parking lots' },
  { href: '/services/sealcoating', label: 'Sealcoating' },
  { href: '/services/asphalt-repair', label: 'Patching and repair' },
  { href: '/services/road-base-grading', label: 'Road base and grading' },
  { href: '/services/dirt-work', label: 'Dirt work' },
];
---
<header class="hdr band">
  <div class="wrap hdr__in">
    <a class="logo" href="/" aria-label="CGH Operations home">
      <img class="logo__mark" src="/img/brand/cgh-badge-white.webp" alt="" width="31" height="39" />
      <span class="logo__text">CGH Operations</span>
    </a>
    <nav class="nav" aria-label="Main">
      {links.map((l) => <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <div class="hdr__cta">
      <a class="hdr__signin" href="/app">Sign in</a>
      <a class="hdr__phone" href={site.phoneHref}>{site.phone}</a>
      <a class="btn btn--paver hdr__btn" href="/quote">Get my price</a>
    </div>
    <details class="menu">
      <summary aria-label="Menu"><span></span><span></span><span></span></summary>
      <div class="menu__panel band">
        <div class="menu__btns">
          <a class="btn btn--paver" href="/quote">Get my price</a>
          <a class="btn btn--line" href={site.phoneHref}>Call {site.phone}</a>
        </div>
        <a class="menu__tile" href="/">Home</a>
        {links.map((l) => <a class="menu__tile" href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>)}
        <a class="menu__tile" href="/app">Sign in</a>
        <p class="menu__head">Most asked about</p>
        {quick.map((l) => <a class="menu__tile menu__tile--sm" href={l.href}>{l.label}</a>)}
      </div>
    </details>
  </div>
</header>

<style>
  .hdr { position: sticky; top: 0; z-index: 80; border-bottom: 1px solid var(--border); }
  .hdr__in { display: flex; align-items: center; gap: 28px; min-height: 68px; }
  .logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-family: var(--font-display); font-size: 1.2rem; font-weight: 600; letter-spacing: -0.01em; white-space: nowrap; }
  .logo b { font-weight: 900; }
  .logo__mark { width: 31px; height: 39px; display: block; }
  .nav { display: none; gap: 22px; margin-left: auto; }
  .nav a { text-decoration: none; font-weight: 500; font-size: 0.98rem; color: var(--text-2); padding: 6px 0; border-bottom: 2px solid transparent; }
  .nav a:hover, .nav a[aria-current] { color: #fff; border-bottom-color: var(--paver); }
  .hdr__cta { display: none; align-items: center; gap: 18px; }
  .hdr__signin { text-decoration: none; font-weight: 500; font-size: 0.95rem; color: var(--text-2); white-space: nowrap; }
  .hdr__signin:hover { color: #fff; }
  .hdr__phone { font-family: var(--font-display); font-weight: 800; text-decoration: none; white-space: nowrap; }
  .hdr__btn { min-height: 44px; padding: 0 18px; font-size: 0.98rem; }
  .menu { margin-left: auto; }
  .menu summary { list-style: none; width: 46px; height: 46px; display: grid; align-content: center; justify-items: center; gap: 5px; cursor: pointer; border: 1.5px solid var(--border-strong); border-radius: var(--radius); }
  .menu summary::-webkit-details-marker { display: none; }
  .menu summary span { width: 20px; height: 2px; background: #fff; }
  /* The phone menu: a full sheet of big two-across buttons between the header and the bottom bar. */
  .menu__panel { position: absolute; left: 0; right: 0; top: 100%; height: calc(100dvh - 69px - 56px - env(safe-area-inset-bottom)); overflow-y: auto; overscroll-behavior: contain; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; align-content: start; padding: 16px var(--gutter) 28px; border-bottom: 1px solid var(--border); }
  .menu__btns { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding-bottom: 6px; }
  .menu__btns .btn { width: 100%; min-height: 54px; font-size: 1rem; padding: 0 8px; white-space: normal; text-align: center; line-height: 1.15; }
  .menu__tile { display: flex; align-items: center; min-height: 58px; padding: 10px 14px; border: 1px solid var(--border-strong); border-radius: var(--radius); background: var(--asphalt-2); text-decoration: none; font-family: var(--font-display); font-weight: 800; font-size: 1.12rem; line-height: 1.15; }
  .menu__tile[aria-current] { border-color: var(--paver); box-shadow: inset 0 0 0 1px var(--paver); }
  .menu__tile--sm { min-height: 48px; font-size: 0.98rem; font-weight: 700; color: var(--text-2); background: none; }
  .menu__head { grid-column: 1 / -1; margin: 12px 0 0; color: var(--muted); font-size: 0.86rem; font-weight: 600; }
  @media (min-width: 861px) { .menu__panel { height: auto; max-height: calc(100dvh - 70px); } }
  @media (min-width: 1140px) {
    .nav, .hdr__cta { display: flex; }
    .menu { display: none; }
  }
</style>
