---
// The opening moment: about three seconds of CGH's own LeeBoy paver laying hot mix, steam and all,
// with the company line over it. Then it fades into the homepage.
//
// This is real footage (Colton's clip IMG_2818), cut two ways: wide for computers, tall for phones.
// Plays once per visit. A tap, click, key press or scroll skips it. The fade-out is CSS only, so it
// can never get stuck, and it is skipped for people who have "reduce motion" turned on.
---
<div class="intro" data-intro>
  <video class="intro__video" muted playsinline autoplay preload="auto" aria-hidden="true"></video>
  <script is:inline>
    (function () {
      var v = document.currentScript.previousElementSibling;
      var kind = matchMedia('(orientation: portrait)').matches ? 'tall' : 'wide';
      v.poster = '/video/paver-intro-' + kind + '.webp';
      v.src = '/video/paver-intro-' + kind + '.mp4';
      var done = function () { document.documentElement.classList.add('paved'); };
      ['pointerdown', 'keydown', 'wheel', 'touchstart'].forEach(function (e) { addEventListener(e, done, { once: true, passive: true }); });
    })();
  </script>
  <div class="intro__shade" aria-hidden="true"></div>
  <div class="intro__line" aria-hidden="true">
    <p>From breaking ground<br />to groundbreaking.</p>
    <p><b>CGH</b> brings results.</p>
  </div>
  <button class="intro__skip" type="button">Skip</button>
</div>

<style>
  .intro {
    position: fixed; inset: 0; z-index: 500; overflow: hidden;
    background: #1b1c1e url('/video/paver-intro-wide.webp') center / cover no-repeat;
    animation: intro-out 0.55s ease 3.3s forwards;
  }
  @media (orientation: portrait) { .intro { background-image: url('/video/paver-intro-tall.webp'); } }
  :global(html.paved) .intro { display: none; }

  .intro__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .intro__shade { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(15, 16, 18, 0.92) 0%, rgba(15, 16, 18, 0.55) 34%, rgba(15, 16, 18, 0.05) 62%); }

  .intro__line { position: absolute; left: 0; right: 0; bottom: 0; padding: 0 var(--gutter) calc(clamp(36px, 8vh, 84px) + env(safe-area-inset-bottom)); max-width: var(--max); margin: 0 auto; color: #fff; font-family: var(--font-display); }
  .intro__line p { margin: 0; font-weight: 900; letter-spacing: -0.03em; line-height: 0.98; font-size: clamp(2.5rem, 8vw, 6.4rem); opacity: 0; animation: intro-word 0.6s var(--ease) 0.3s forwards; }
  .intro__line p + p { color: var(--paver); font-size: clamp(1.6rem, 4.4vw, 3.4rem); margin-top: 14px; animation-delay: 1.35s; }

  .intro__skip { position: absolute; right: 14px; top: 14px; padding: 8px 14px; border: 0; border-radius: 999px; background: rgba(15, 16, 18, 0.6); color: #fff; font: 600 0.9rem var(--font-body); cursor: pointer; }

  @keyframes intro-word { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes intro-out { to { opacity: 0; visibility: hidden; } }
  @media (prefers-reduced-motion: reduce) { .intro { display: none; } }
</style>
