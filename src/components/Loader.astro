---
// The opening moment: a yellow paver crosses the screen laying a strip of fresh asphalt,
// the strip spreads to fill the screen, and the site appears on top of it.
// Plays once per visit (not on every page), runs on CSS alone so it can never get stuck,
// and is skipped entirely for people who have "reduce motion" turned on.
---
<div class="paving" aria-hidden="true">
  <p class="paving__name">CGH Operations</p>
  <div class="paving__ground"></div>
  <div class="paving__train">
    <div class="paving__mat"></div>
    <svg class="paving__paver" viewBox="0 0 250 122" xmlns="http://www.w3.org/2000/svg">
      <!-- canopy -->
      <rect x="74" y="6" width="96" height="7" rx="2" fill="#f4b400" />
      <rect x="80" y="13" width="4" height="42" fill="#33363a" />
      <rect x="160" y="13" width="4" height="30" fill="#33363a" />
      <!-- operator seat and console -->
      <rect x="96" y="34" width="9" height="22" rx="2" fill="#26282b" />
      <rect x="96" y="48" width="22" height="8" rx="2" fill="#26282b" />
      <rect x="126" y="36" width="6" height="20" rx="1" fill="#26282b" />
      <circle cx="129" cy="34" r="6" fill="none" stroke="#26282b" stroke-width="3" />
      <!-- exhaust and engine hood -->
      <rect x="150" y="20" width="5" height="24" rx="2" fill="#33363a" />
      <rect x="138" y="42" width="46" height="16" rx="3" fill="#ffc928" />
      <!-- main body -->
      <path d="M62 56h126l8 10v24H62z" fill="#f4b400" />
      <rect x="74" y="64" width="62" height="5" rx="2" fill="#1b1c1e" opacity="0.85" />
      <!-- hopper (front, right side) -->
      <path d="M190 60h44l10 30h-48z" fill="#ffc928" />
      <path d="M196 60l-4-9h44l8 9z" fill="#b98300" />
      <path d="M202 66h30l5 16h-32z" fill="#1b1c1e" opacity="0.8" />
      <circle cx="243" cy="104" r="6" fill="#33363a" />
      <!-- track -->
      <rect x="68" y="86" width="128" height="28" rx="14" fill="#1b1c1e" />
      <rect x="74" y="92" width="116" height="16" rx="8" fill="#33363a" />
      <circle cx="84" cy="100" r="6" fill="#63676c" /><circle cx="108" cy="100" r="6" fill="#63676c" /><circle cx="132" cy="100" r="6" fill="#63676c" /><circle cx="156" cy="100" r="6" fill="#63676c" /><circle cx="180" cy="100" r="6" fill="#63676c" />
      <!-- screed (rear, left side) with walkway rail -->
      <path d="M60 78l-34 10" stroke="#b98300" stroke-width="5" stroke-linecap="round" />
      <rect x="10" y="86" width="50" height="18" rx="2" fill="#b98300" />
      <rect x="6" y="102" width="58" height="8" rx="1" fill="#33363a" />
      <path d="M16 86V68h34v18M33 68v18" fill="none" stroke="#33363a" stroke-width="3" />
    </svg>
  </div>
  <div class="paving__fill"></div>
</div>

<style>
  .paving {
    --road: 62vh;        /* where the ground line sits */
    --paver-w: clamp(190px, 26vw, 320px);
    --mat: clamp(10px, 1.3vw, 16px);
    position: fixed; inset: 0; z-index: 500; overflow: hidden;
    background: var(--limestone);
    animation: paving-out 0.45s ease 2.55s forwards;
  }
  :global(html.paved) .paving { display: none; }

  .paving__name {
    position: absolute; left: 0; right: 0; top: calc(var(--road) - clamp(190px, 30vw, 330px)); margin: 0; text-align: center;
    font-family: var(--font-display); font-weight: 900; font-size: clamp(1.6rem, 4vw, 2.6rem); letter-spacing: -0.02em; color: var(--asphalt);
    animation: paving-name 0.5s ease 0.1s both;
  }
  /* the limestone base the paver drives on */
  .paving__ground { position: absolute; left: 0; right: 0; top: var(--road); bottom: 0; background: var(--limestone-2); border-top: 2px solid rgba(27, 28, 30, 0.18); }

  /* mat + paver travel together: the mat is one screen wide and the paver rides its leading edge */
  .paving__train {
    position: absolute; left: 0; top: 0; height: var(--road);
    width: calc(100vw + var(--paver-w));
    transform: translateX(calc(-100vw - var(--paver-w)));
    animation: paving-drive 1.9s cubic-bezier(0.45, 0.05, 0.55, 0.95) 0.15s forwards;
  }
  .paving__mat { position: absolute; left: 0; bottom: 0; width: 100vw; height: var(--mat); background: var(--asphalt); transform: translateY(100%); }
  .paving__paver { position: absolute; right: 0; bottom: calc(var(--mat) * -1 + 1px); width: var(--paver-w); height: auto; margin-right: calc(var(--paver-w) * -0.04); }

  /* the strip spreads into a full sheet of asphalt, then the whole thing fades to the site */
  .paving__fill { position: absolute; left: 0; right: 0; top: var(--road); height: var(--mat); background: var(--asphalt); transform-origin: 50% 50%; transform: scaleY(0); animation: paving-spread 0.5s var(--ease) 2.05s forwards; }

  @keyframes paving-drive { to { transform: translateX(0); } }
  @keyframes paving-spread { from { transform: scaleY(1); } to { transform: scaleY(160); } }
  @keyframes paving-name { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @keyframes paving-out { to { opacity: 0; visibility: hidden; } }

  @media (prefers-reduced-motion: reduce) { .paving { display: none; } }
</style>
