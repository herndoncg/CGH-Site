---
// The opening moment, seen from straight above: a yellow paver enters at the bottom left,
// runs an S-curve to the top right laying fresh asphalt, then the asphalt spreads to fill
// the screen and the site appears on top of it.
//
// This drawn paver is a STAND-IN. The plan is to swap it for a realistic clip (AI-generated
// first, real drone footage later) that follows the same path and timing.
//
// Plays once per visit, needs no script to finish (so it can never get stuck), and is skipped
// for people who have "reduce motion" turned on. There are two drawings: wide screens and tall
// phone screens each get their own curve so the paver always starts bottom-left.
const views = [
  { cls: 'wide', box: '0 0 1600 900', mat: 190, scale: 1, d: 'M -260 800 C 520 800, 520 470, 800 450 C 1080 430, 1080 100, 1900 100' },
  { cls: 'tall', box: '0 0 900 1600', mat: 170, scale: 0.9, d: 'M -260 1420 C 620 1420, 230 930, 450 800 C 670 670, 280 180, 1180 180' },
];
const DRIVE = '2.5s';   // how long the paver takes to cross
const SPREAD = '2.35s'; // when the asphalt starts filling the screen
---
<div class="paving" aria-hidden="true">
  {views.map((v) => (
    <svg class={`paving__svg paving__svg--${v.cls}`} viewBox={v.box} preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <filter id={`grain-${v.cls}`} x="0" y="0" width="100%" height="100%">
          <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="7" />
          <feColorMatrix values="0 0 0 0 0.35  0 0 0 0 0.3  0 0 0 0 0.22  0 0 0 0.22 0" />
        </filter>
        <filter id={`shadow-${v.cls}`} x="-30%" y="-30%" width="160%" height="160%">
          <feDropShadow dx="10" dy="14" stdDeviation="9" flood-color="#000" flood-opacity="0.38" />
        </filter>
        <path id={`route-${v.cls}`} d={v.d} />
      </defs>

      <!-- graded rock base -->
      <rect width="100%" height="100%" fill="#cdbf9f" />
      <rect width="100%" height="100%" filter={`url(#grain-${v.cls})`} />

      <!-- the asphalt mat, laid along the route as the paver moves -->
      <path d={v.d} fill="none" stroke="#131416" stroke-width={v.mat} pathLength="1" stroke-dasharray="1 1" stroke-dashoffset="1">
        <animate attributeName="stroke-dashoffset" from="1" to="0" dur={DRIVE} begin="0.15s" fill="freeze" />
        <animate attributeName="stroke-width" from={v.mat} to="5200" dur="0.65s" begin={SPREAD} fill="freeze" calcMode="spline" keyTimes="0;1" keySplines="0.5 0 0.2 1" />
      </path>
      <!-- faint roller marks on the fresh mat -->
      <path d={v.d} fill="none" stroke="#2a2c2f" stroke-width={v.mat * 0.34} pathLength="1" stroke-dasharray="1 1" stroke-dashoffset="1" opacity="0.55">
        <animate attributeName="stroke-dashoffset" from="1" to="0" dur={DRIVE} begin="0.15s" fill="freeze" />
        <animate attributeName="opacity" to="0" dur="0.3s" begin={SPREAD} fill="freeze" />
      </path>

      <!-- the paver, top view. Its screed (rear edge) sits at the end of the mat. -->
      <g filter={`url(#shadow-${v.cls})`}>
        <g transform={`scale(${v.scale})`}>
          <!-- screed with end gates and walkway -->
          <rect x="-6" y="-100" width="34" height="200" rx="3" fill="#8a6a12" />
          <rect x="-2" y="-106" width="26" height="12" rx="2" fill="#33363a" /><rect x="-2" y="94" width="26" height="12" rx="2" fill="#33363a" />
          <rect x="4" y="-92" width="14" height="184" fill="#5c4a14" />
          <!-- tracks -->
          <rect x="34" y="-74" width="128" height="20" rx="6" fill="#17181a" /><rect x="34" y="54" width="128" height="20" rx="6" fill="#17181a" />
          <!-- tractor body -->
          <rect x="28" y="-58" width="134" height="116" rx="8" fill="#f4b400" />
          <rect x="118" y="-46" width="40" height="92" rx="5" fill="#e0a400" />
          <circle cx="146" cy="-28" r="7" fill="#33363a" /><circle cx="146" cy="-28" r="3.5" fill="#111" />
          <!-- operator deck, seat and canopy roof -->
          <rect x="40" y="-48" width="70" height="96" rx="4" fill="#3a3d41" />
          <rect x="56" y="-14" width="26" height="28" rx="5" fill="#17181a" />
          <rect x="44" y="-54" width="66" height="108" rx="6" fill="#ffc928" opacity="0.92" />
          <rect x="50" y="-48" width="54" height="96" rx="4" fill="none" stroke="#b98300" stroke-width="2" />
          <!-- hopper full of hot mix, wings open -->
          <path d="M162 -62 L250 -84 L258 -70 L258 70 L250 84 L162 62 Z" fill="#ffc928" />
          <path d="M170 -50 L246 -68 L246 68 L170 50 Z" fill="#1b1c1e" />
          <path d="M178 -38 Q210 -52 240 -40 L240 40 Q210 52 178 38 Z" fill="#2c2e31" />
          <rect x="256" y="-34" width="8" height="26" rx="3" fill="#33363a" /><rect x="256" y="8" width="8" height="26" rx="3" fill="#33363a" />
        </g>
        <animateMotion dur={DRIVE} begin="0.15s" fill="freeze" rotate="auto" calcMode="linear" keyPoints="0;1" keyTimes="0;1">
          <mpath href={`#route-${v.cls}`} />
        </animateMotion>
      </g>
    </svg>
  ))}
  <p class="paving__name">CGH Operations</p>
</div>

<style>
  .paving { position: fixed; inset: 0; z-index: 500; overflow: hidden; background: #cdbf9f; animation: paving-out 0.4s ease 3s forwards; }
  :global(html.paved) .paving { display: none; }
  .paving__svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .paving__svg--tall { display: none; }
  @media (orientation: portrait) {
    .paving__svg--wide { display: none; }
    .paving__svg--tall { display: block; }
  }
  .paving__name {
    position: absolute; left: var(--gutter); top: clamp(20px, 5vh, 48px); margin: 0;
    font-family: var(--font-display); font-weight: 900; font-size: clamp(1.5rem, 3.4vw, 2.4rem); letter-spacing: -0.02em; color: var(--asphalt);
    animation: paving-name 0.5s ease 0.1s both, paving-name-flip 0.3s ease 2.5s forwards;
  }
  @keyframes paving-name { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @keyframes paving-name-flip { to { color: #fff; } }
  @keyframes paving-out { to { opacity: 0; visibility: hidden; } }
  @media (prefers-reduced-motion: reduce) { .paving { display: none; } }
</style>
