---
// The four states we work in, drawn from US Census outlines, with our two bases marked.
// Same look as the map on the A&H Lease Services site, in CGH's colors: Texas one shade lighter than
// its neighbors, thin dark outlines, spaced capital names, and a home-base dot that glows.
// tone="light" sits on the grey page, tone="dark" sits on a navy band.
import map from '../data/states-map.json';
interface Props { tone?: 'light' | 'dark' }
const { tone = 'light' } = Astro.props;
const [lx, ly] = map.pins.longview;
const [tx, ty] = map.pins.texarkana;
// Where each state's name sits. Nudged off the plain centre so names clear the pins and the panhandles.
const label: Record<string, [number, number]> = { Texas: [372, 486], Oklahoma: [556, 192], Arkansas: [781, 212], Louisiana: [826, 494] };
---
<figure class={`smap smap--${tone}`}>
  <svg viewBox={`0 0 ${map.w} ${map.h}`} role="img" aria-label="Map of Texas, Arkansas, Oklahoma and Louisiana. Our two bases are marked: Longview, Texas, where we started, and Texarkana, Texas.">
    <defs>
      <radialGradient id="smap-glow">
        <stop offset="0" stop-color="#2cc4c8" stop-opacity="0.85" />
        <stop offset="0.45" stop-color="#2cc4c8" stop-opacity="0.3" />
        <stop offset="1" stop-color="#2cc4c8" stop-opacity="0" />
      </radialGradient>
    </defs>
    {map.states.map((s) => <path class={`smap__state smap__state--${s.name.toLowerCase()}`} d={s.d} />)}
    {map.states.map((s) => <text class={`smap__name smap__name--${s.name.toLowerCase()}`} x={label[s.name][0]} y={label[s.name][1]} text-anchor="middle">{s.name}</text>)}
    <g class="smap__pin smap__pin--second">
      <circle class="smap__dot" cx={tx} cy={ty} r="7" />
      <text x={tx - 18} y={ty + 2} text-anchor="end">Texarkana</text>
    </g>
    <g class="smap__pin smap__pin--home">
      <circle class="smap__glow" cx={lx} cy={ly} r="58" fill="url(#smap-glow)" />
      <circle class="smap__pulse" cx={lx} cy={ly} r="20" />
      <circle class="smap__ring" cx={lx} cy={ly} r="20" />
      <circle class="smap__dot" cx={lx} cy={ly} r="9" />
      <text x={lx - 32} y={ly + 12} text-anchor="end">Longview</text>
    </g>
  </svg>
</figure>

<style>
  .smap { margin: 0; --land: #12314a; --land-home: #005f86; --edge: var(--chalk); --ink: #f2f5f9; --glow: var(--paver-bright); }
  .smap--dark { --land: #14304a; --edge: #0b1220; }
  .smap svg { display: block; width: 100%; height: auto; overflow: visible; }
  .smap__state { fill: var(--land); stroke: var(--edge); stroke-width: 3; stroke-linejoin: round; }
  .smap__state--texas { fill: var(--land-home); }
  .smap__name { fill: var(--ink); font-family: var(--font-display); font-weight: 700; font-size: 25px; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.8; }
  .smap__name--texas { font-size: 44px; }
  .smap__name--louisiana { font-size: 21px; }
  .smap__pin text { fill: #fff; font-family: var(--font-display); font-weight: 800; font-size: 34px; paint-order: stroke; stroke: var(--land-home); stroke-width: 8px; stroke-linejoin: round; }
  .smap__pin--second text { font-size: 24px; font-weight: 700; stroke-width: 6px; opacity: 0.92; }
  .smap__dot { fill: var(--glow); }
  .smap__ring { fill: none; stroke: var(--glow); stroke-width: 3; }
  .smap__glow { transform-box: fill-box; transform-origin: center; animation: smap-glow 2.8s ease-in-out infinite alternate; }
  .smap__pulse { fill: none; stroke: var(--glow); stroke-width: 3; transform-box: fill-box; transform-origin: center; animation: smap-pulse 2.8s ease-out infinite; }
  @keyframes smap-glow { from { opacity: 0.6; transform: scale(0.88); } to { opacity: 1; transform: scale(1.08); } }
  @keyframes smap-pulse { from { transform: scale(1); opacity: 0.8; } to { transform: scale(2.6); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .smap__pulse { animation: none; opacity: 0; } .smap__glow { animation: none; } }
</style>
