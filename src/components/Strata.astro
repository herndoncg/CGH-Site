---
// A cross-section of a paved surface. It shows the three things a paving price is made of,
// in the order they sit in the ground.
interface Props { heading?: string }
const { heading = 'What you are paying for, from the top down' } = Astro.props;
const layers = [
  { cls: 'top', name: 'Asphalt', what: 'Hot mix laid with our paver and rolled tight. Priced by the square foot, and the rate drops as the job gets bigger.' },
  { cls: 'base', name: 'Rock base', what: 'Crushed rock under the asphalt wherever the ground is thin or soft. Priced by the dump truck load, only for the area that needs it.' },
  { cls: 'ground', name: 'Graded ground', what: 'Washouts fixed and the ground shaped so water runs off. One flat charge, only if your site needs it.' },
];
---
<section class="strata">
  <div class="wrap">
    <h2>{heading}</h2>
    <div class="strata__stack">
      {layers.map((l) => (
        <div class={`strata__layer strata__layer--${l.cls}`}>
          <h3>{l.name}</h3>
          <p>{l.what}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .strata { padding: var(--section) 0; background: var(--bg-2); }
  .strata h2 { max-width: 18ch; margin-bottom: 36px; }
  .strata__stack { border-radius: var(--radius-lg); overflow: hidden; box-shadow: 0 18px 50px rgba(11, 18, 32, 0.16); }
  .strata__layer { display: grid; gap: 6px 40px; padding: clamp(22px, 3vw, 34px) clamp(20px, 4vw, 44px); grid-template-columns: 1fr; align-items: baseline; }
  @media (min-width: 760px) { .strata__layer { grid-template-columns: 220px 1fr; } }
  .strata__layer h3 { margin: 0; font-size: 1.5rem; font-weight: 900; }
  .strata__layer p { margin: 0; max-width: 62ch; }
  .strata__layer--top { background-color: #1b1c1e; color: #f2f5f9; background-image: radial-gradient(rgba(255, 255, 255, 0.09) 1px, transparent 1.4px); background-size: 7px 7px; }
  .strata__layer--top h3 { color: #fff; }
  .strata__layer--base { background-color: #cfcabb; color: #1b1c1e; background-image: radial-gradient(circle at 30% 40%, rgba(11, 18, 32, 0.09) 2.2px, transparent 2.8px), radial-gradient(circle at 75% 70%, rgba(255, 255, 255, 0.38) 2.6px, transparent 3.2px); background-size: 19px 17px, 23px 21px; }
  .strata__layer--ground { background: linear-gradient(180deg, #9a4427, #7c3319); color: #fbeee6; }
</style>
