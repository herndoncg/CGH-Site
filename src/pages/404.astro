---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="That page is not here." noindex>
  <section class="section">
    <div class="wrap narrow">
      <h1>This road is closed.</h1>
      <p class="lede">The page you were looking for is not here. Try one of these instead.</p>
      <div class="btn-row" style="margin-top:28px"><a class="btn btn--paver" href="/quote">Get my price range</a><a class="btn btn--line" href="/services">See our services</a></div>
    </div>
  </section>
</Base>
