      const tone = (s: string) => (s === 'Ready' ? 's-Accepted' : s === 'Down' ? 's-Lost' : 's-warn');
      return { eyebrow: 'Shop', title: 'Equipment', sub: 'Hours, status and a running log for every machine. Anyone on the crew can report a problem.',
        body: `${equipment.map((e: any) => `<details class="lead" ${S.open === e.id ? 'open' : ''}><summary><span class="stage ${tone(e.status)}">${esc(e.status)}</span><b>${esc(e.name)}</b><span class="muted">${esc(e.kind)}${e.hours ? ` · ${Number(e.hours).toLocaleString('en-US')} hrs` : ''}</span><span class="amt"></span><span class="muted small">${e.log?.[0] ? day(e.log[0].at) : ''}</span></summary><div class="lead__body"><form data-form="equip" data-id="${e.id}" class="grid2"><div class="field"><label>Status<select name="status">${['Ready', 'Needs service', 'Down'].map((s) => `<option ${s === e.status ? 'selected' : ''}>${s}</option>`).join('')}</select></label></div><div class="field"><label>Hours or miles now<input name="hours" inputmode="decimal" value="${e.hours || ''}" /></label></div><div class="field full"><label>Note (what is wrong, what was done)<textarea name="note"></textarea></label></div><div class="full row"><button class="btn btn--paver">Save</button>${boss ? `<button type="button" class="btn btn--line" data-act="equipdel" data-id="${e.id}">${S.confirm === e.id ? 'Tap again to remove' : 'Remove machine'}</button>` : ''}</div></form>${e.log?.length ? `<ul class="notes">${e.log.slice(0, 6).map((n: any) => `<li><span class="muted small">${day(n.at)} · ${esc(n.by)}</span><br />${esc(n.text)}</li>`).join('')}</ul>` : ''}</div></details>`).join('')}
          ${boss ? `<details class="card fold"><summary>Add a machine</summary><form data-form="newequip" class="grid2">${field('Name', 'name', 'text', 'required')}<div class="field"><label>Kind<select name="kind"><option>Paving</option><option>Dirt work</option><option>Hauling</option><option>Other</option></select></label></div><div class="full"><button class="btn btn--paver">Add</button></div></form></details>` : ''}` };
    },
    async estimate() {
      const st = await api('estimate-settings'); const boss = BOSS.includes(S.me.role);
      S.est = { p: st.prices, c: st.contractor || {} }; const p = S.est.p, c = S.est.c;
      const n = (label: string, name: string, val: unknown, extra = '') => field(label, name, 'text', `inputmode="decimal" value="${esc(val ?? '')}" ${extra}`);
      return { eyebrow: 'Sales', title: 'Three-option estimate', sub: 'Economy, Premium and Elite, priced the way your estimation sheet does it.',
        body: `<form data-form="estimate" class="stack"><div class="cols">
          ${card('The job', `<div class="grid2">${field('Customer name', 'name')}${field('Phone', 'phone', 'tel')}${field('Town or address', 'city')}${n('Length (ft)', 'length', '')}${n('Width (ft)', 'width', '')}${n('Or total square feet', 'sqft', '')}</div><p class="muted small">Jobs under ${p.min_sqft.toLocaleString('en-US')} sq ft are priced at ${p.min_sqft.toLocaleString('en-US')}.</p>`)}
          ${card('Prices to the customer', `<div class="grid2">${n('Hot mix, $ per square yard', 'hotmix_sqyd', p.hotmix_sqyd)}${n('Seal coat, $ per sq ft', 'seal_sqft', p.seal_sqft)}${n('Hot oil treatment, $ per sq ft', 'hotoil_sqft', p.hotoil_sqft)}${n('Sales tax %', 'tax_pct', p.tax_pct)}${n('Deposit %', 'deposit_pct', p.deposit_pct)}</div><p class="muted small" data-est="persqft"></p>`)}
        </div>
        ${boss ? card('What you pay your contractor <span class="pill">only you see this</span>', `<div class="grid2">${n('Hot mix, $ per square yard', 'c_hotmix_sqyd', c.hotmix_sqyd)}${n('Seal coat, $ per sq ft', 'c_seal_sqft', c.seal_sqft)}${n('Hot oil treatment, $ per sq ft', 'c_hotoil_sqft', c.hotoil_sqft)}</div><div class="row"><button type="button" class="btn btn--line" data-act="estsave">Save these numbers as my defaults</button></div><p class="muted small">Kept in the app's private storage. Sales and crew never see this box or the profit lines.</p>`) : ''}
        <div class="opts" data-est="out"></div>
        <div class="row"><button class="btn btn--paver">Save the picked option as a lead</button></div></form>` };
