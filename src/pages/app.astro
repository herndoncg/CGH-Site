    async matcost() {
      const st = await api('estimate-settings'); const m = st.materials || {}; S.est = { p: st.prices, c: st.contractor || {} };
      const v = (id: string, f: string, d: unknown = '') => esc(m[id]?.[f] ?? d);
      const n = (label: string, name: string, val: unknown, hint = '') => `<div class="field"><label>${label}<input name="${name}" inputmode="decimal" value="${val}" />${hint ? `<small>${hint}</small>` : ''}</label></div>`;
      const tick = (name: string, label: string, on: boolean) => `<label class="showpw"><input type="checkbox" name="${name}" ${on ? 'checked' : ''} /> ${label}</label>`;
      const LAYERS: [string, string, string, number, number, string][] = [['d', 'Type D hot mix', 'Surface layer, ½ inch rock, 1.5 to 2 in thick', 2.015, 25, ''], ['c', 'Type C hot mix', 'Intermediate layer, ¾ inch rock, 2 to 3 in thick', 2, 15, 'Average $88 to $125'], ['b', 'Type B hot mix', 'Base layer, 1 inch rock, 3 to 6 in thick', 2, 15, ''], ['agg', 'Aggregate base', 'TxDOT Item 247, Grade 1, Type A', 1.25, 15, '']];
      const LIQ: [string, string, string, number, number, string, string][] = [['tack', 'Tack coat (CSS-1H)', 'Bonds one asphalt layer to the next', 0.08, 7.5, 'Average 0.08', 'Average $3.50 to $12'], ['prime', 'Primer (AE-P)', 'Soaks into the rock base before paving', 0.5, 7, 'Average 0.25 to 0.5', 'Average $2.75 to $9'], ['seal', 'Seal coat (MasterSeal AE)', 'Surface sealant', 0.15, 7, 'Average 0.1 to 0.15', 'Average $3.25 to $4.75']];
      return { eyebrow: 'Shop', title: 'Materials cost', sub: 'What a job costs you in material, layer by layer. Only you see this page.',
