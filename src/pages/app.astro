---
// cghoperations.com/app : the sign-in page and the app behind it.
// One page, three doors: owner, team (sales and crew), and customers.
// It talks to the back end in netlify/functions (see lib/core.mjs for who can see what).
//
// Layout follows the B&H Operations app: a side menu in groups, a job photo behind every page
// header, and a Bible verse at the foot of every page. Colors are CGH's navy and teal.
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="CGH Operations app" description="Sign in for CGH Operations customers and team." noindex bare>
  <div id="app" data-phone={site.phone} data-phone-href={site.phoneHref}>
    <p class="boot">Loading…</p>
  </div>
</Base>

<script>
  import { estimate, type Pricing } from '../lib/pricing';
  import { options, layer, liquid, yardage } from '../lib/estimate';
  import guide from '../data/field-guide.json';

  type Role = 'owner' | 'manager' | 'sales' | 'crew' | 'client';
  type Me = { id: string; name: string; email: string; role: Role; mustChange?: boolean };
  const root = document.getElementById('app')!;
  const PHONE = root.dataset.phone!, PHONE_HREF = root.dataset.phoneHref!;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const money = (n: number) => (n ? '$' + Math.round(n).toLocaleString('en-US') : '');
  const num = (v: unknown) => { const n = parseFloat(String(v ?? '').replace(/[^0-9.]/g, '')); return Number.isFinite(n) ? n : 0; };
  const day = (t: number) => new Date(t).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  const longDay = (iso: string) => new Date(iso + 'T12:00').toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric' });
  const today = () => new Date().toLocaleDateString('en-CA'); // 2026-11-12, in this phone's own time zone
  const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
  const shortDay = (iso: string) => new Date(iso + 'T12:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  // Hot mix figured at 2 tons per cubic yard, the same as the estimation sheet.
  const tons = (sqft: number, inches = 2) => (Math.ceil((((sqft * (inches / 12)) / 27) * 2) * 10) / 10).toLocaleString('en-US');
  const usd = (n: number) => '$' + (Number.isFinite(n) ? n : 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const dec = (n: number, d = 2) => (Number.isFinite(n) ? n : 0).toLocaleString('en-US', { maximumFractionDigits: d });
  const api = async (path: string, method = 'GET', data?: unknown) => {
    const r = await fetch('/api/' + path, { method, credentials: 'same-origin', headers: data ? { 'content-type': 'application/json' } : {}, body: data ? JSON.stringify(data) : undefined });
    const j = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(j.error || 'Something went wrong. Try again.');
    return j;
  };
  const S: any = { me: null as Me | null, view: 'home', msg: '', ok: '', filter: 'Open', q: '' };

  // ---------- the menu, the photo behind each page, and the verse under it ----------
  const ICON: Record<string, string> = {
    home: 'M3 11l9-8 9 8v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z', schedule: 'M4 6h16v14H4zM4 10h16M8 3v4M16 3v4', jobs: 'M3 8h18v11H3zM8 8V5h8v3',
    pipeline: 'M4 4h4v16H4zM10 4h4v10h-4zM16 4h4v6h-4z', customers: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 20c0-4 4-6 8-6s8 2 8 6', quote: 'M12 3v18M16 7c0-2-2-3-4-3s-4 1-4 3 2 3 4 3 4 1 4 3-2 3-4 3-4-1-4-3', estimate: 'M4 6h16M4 12h16M4 18h16M8 4v4M14 10v4M10 16v4', guide: 'M5 4h11l3 3v13H5zM9 9h6M9 13h6M9 17h4', matcost: 'M4 20V10l8-6 8 6v10zM9 20v-6h6v6',
    announcements: 'M4 10v4h3l6 4V6L7 10zM16 9a4 4 0 0 1 0 6', training: 'M4 5h7a2 2 0 0 1 2 2v12a2 2 0 0 0-2-2H4zM20 5h-7v14h7z', team: 'M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z', hiring: 'M5 12l4 4L19 7',
    equipment: 'M2 7h11v9H2zM13 10h5l3 3v3h-8zM6 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM17 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4z', calc: 'M5 3h14v18H5zM8 7h8M8 12h2M12 12h2M8 16h2M12 16h2', account: 'M6 11h12v9H6zM9 11V8a3 3 0 0 1 6 0v3',
    measure: 'M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11zM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z',
    bell: 'M6 16v-5a6 6 0 0 1 12 0v5l2 2H4zM10 20a2 2 0 0 0 4 0', menu: 'M4 7h16M4 12h16M4 17h16', search: 'M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM20 20l-4-4', phone: 'M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z',
  };
  const icon = (k: string) => `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${ICON[k]}"/></svg>`;
  // Who gets which screens. A manager sees everything the owner sees.
  const ALL: Role[] = ['owner', 'manager', 'sales', 'crew'], SELL: Role[] = ['owner', 'manager', 'sales'], BOSS: Role[] = ['owner', 'manager'];
  const ROLE_WORDS: Record<string, string> = { manager: 'Manager: sees and does everything', sales: 'Sales: sees and works leads', crew: 'Crew: sees scheduled jobs, no prices' };
  const NAV: [string, [string, string, Role[]][]][] = [
    ['Today', [['home', 'Home', ALL], ['schedule', 'Schedule', ALL], ['jobs', 'Jobs', ALL]]],
    ['Sales', [['pipeline', 'Pipeline', SELL], ['customers', 'Customers', SELL], ['quote', 'Quick quote', SELL], ['estimate', 'Three-option estimate', SELL]]],
    ['Team', [['announcements', 'Announcements', ALL], ['training', 'Training', ALL], ['guide', 'Field guide', ALL], ['team', 'Team', BOSS], ['hiring', 'Hiring', BOSS]]],
    ['Shop', [['equipment', 'Equipment', ALL], ['measure', 'Measure on a map', ALL], ['calc', 'Yardage and loads', ALL], ['matcost', 'Materials cost', BOSS]]],
    ['You', [['account', 'My account', ALL]]],
  ];
  const PHOTO: Record<string, string> = {
    measure: 'ranch-entrance-asphalt-drive', home: 'paving-crew-with-leeboy-paver', schedule: 'roller-compacting-new-driveway', jobs: 'leeboy-paver-laying-hot-mix', pipeline: 'new-asphalt-driveway-to-garage', customers: 'lake-house-asphalt-driveway', quote: 'curved-asphalt-driveway-east-texas',
    announcements: 'crew-raking-asphalt', training: 'compacting-asphalt-patch', team: 'paving-crew-with-leeboy-paver', hiring: 'crew-raking-asphalt', equipment: 'dump-truck-and-roller', calc: 'base-repair-cut-out', estimate: 'asphalt-garage-pad', guide: 'asphalt-drive-through-pines', matcost: 'leeboy-paver-laying-hot-mix', account: 'circle-drive-at-sunset', auth: 'circle-drive-at-sunset', client: 'long-curved-asphalt-drive',
  };
  // King James Version (public domain).
  const VERSE: Record<string, [string, string]> = {
    home: ['Commit thy works unto the LORD, and thy thoughts shall be established.', 'Proverbs 16:3'],
    schedule: ['Ponder the path of thy feet, and let all thy ways be established.', 'Proverbs 4:26'],
    jobs: ['And whatsoever ye do, do it heartily, as to the Lord, and not unto men.', 'Colossians 3:23'],
    pipeline: ['In all thy ways acknowledge him, and he shall direct thy paths.', 'Proverbs 3:6'],
    customers: ['He that is faithful in that which is least is faithful also in much.', 'Luke 16:10'],
    quote: ['The integrity of the upright shall guide them.', 'Proverbs 11:3'],
    announcements: ['Iron sharpeneth iron; so a man sharpeneth the countenance of his friend.', 'Proverbs 27:17'],
    training: ['Whatsoever thy hand findeth to do, do it with thy might.', 'Ecclesiastes 9:10'],
    team: ['Iron sharpeneth iron; so a man sharpeneth the countenance of his friend.', 'Proverbs 27:17'],
    hiring: ['Two are better than one; because they have a good reward for their labour.', 'Ecclesiastes 4:9'],
    equipment: ['Except the LORD build the house, they labour in vain that build it.', 'Psalm 127:1'],
    calc: ['Every valley shall be exalted, and every mountain and hill shall be made low: and the crooked shall be made straight, and the rough places plain.', 'Isaiah 40:4'],
    measure: ['Thou shalt have a perfect and just weight, a perfect and just measure shalt thou have.', 'Deuteronomy 25:15'],
    estimate: ['A false balance is abomination to the LORD: but a just weight is his delight.', 'Proverbs 11:1'],
    matcost: ['For which of you, intending to build a tower, sitteth not down first, and counteth the cost, whether he have sufficient to finish it?', 'Luke 14:28'],
    guide: ['Wisdom is the principal thing; therefore get wisdom: and with all thy getting get understanding.', 'Proverbs 4:7'],
    account: ['Prepare ye the way of the LORD, make straight in the desert a highway for our God.', 'Isaiah 40:3'],
    auth: ['Prepare ye the way of the LORD, make straight in the desert a highway for our God.', 'Isaiah 40:3'],
    client: ['For I know the thoughts that I think toward you, saith the LORD, thoughts of peace, and not of evil, to give you an expected end.', 'Jeremiah 29:11'],
  };
  // Home shows a different verse each day; every other page keeps its own.
  const daily = () => { const all = [...new Map(Object.values(VERSE).map((v) => [v[1], v])).values()]; return all[Math.floor(Date.now() / 864e5) % all.length]; };
  const verseFoot = (k: string) => { const v = k === 'home' ? daily() : VERSE[k]; return `<p class="verse-foot">“${v[0]}”<span>${v[1]} (KJV)</span></p>`; };
  const photoHead = (k: string, eyebrow: string, title: string, sub = '', actions = '') => `<div class="photo-head" style="--photo:url('/img/work/${PHOTO[k]}.webp')"><div><p class="eyebrow">${esc(eyebrow)}</p><h1>${esc(title)}</h1>${sub ? `<p class="sub">${esc(sub)}</p>` : ''}</div>${actions ? `<div class="row">${actions}</div>` : ''}</div>`;
  const BRAND = '<img src="/img/cgh-mark.png" alt="CGH" width="34" height="34" /><span>Operations</span>';
  const notes = () => `${S.ok ? `<p class="ok" role="status">${esc(S.ok)}</p>` : ''}${S.msg ? `<p class="err" role="alert">${esc(S.msg)}</p>` : ''}`;
  const card = (title: string, body: string, right = '') => `<section class="card"><div class="card__head"><h2>${title}</h2>${right}</div>${body}</section>`;
  const field = (label: string, name: string, type = 'text', extra = '') => `<div class="field"><label>${label}<input name="${name}" type="${type}" ${type === 'password' ? 'data-pw autocapitalize="none" autocorrect="off" spellcheck="false"' : ''} ${extra} /></label></div>`;
  const showPw = '<label class="showpw"><input type="checkbox" data-showpw /> Show what I am typing</label>';

  // ---------- installing the app and alerts ----------
  let installEvt: any = null;
  addEventListener('beforeinstallprompt', (e) => { e.preventDefault(); installEvt = e; if (S.me) render(); });
  const canPush = 'serviceWorker' in navigator && 'PushManager' in window && 'Notification' in window;
  if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(() => {});
  const standalone = matchMedia('(display-mode: standalone)').matches || (navigator as any).standalone === true;
  const isIos = /iphone|ipad|ipod/i.test(navigator.userAgent);
  const keyBytes = (k: string) => Uint8Array.from(atob(k.replace(/-/g, '+').replace(/_/g, '/')), (c) => c.charCodeAt(0));
  const alertWord = () => (S.me.role === 'crew' ? 'announcement alerts' : 'lead alerts');
  const alertsBar = () => {
    if (!S.me || S.me.role === 'client') return '';
    const parts: string[] = [];
    if (installEvt) parts.push('<button class="btn btn--line sm" data-act="install">Install this app</button>');
    else if (isIos && !standalone) parts.push('<span class="small">To put this on your iPhone: tap the Share button, then "Add to Home Screen". Open it from there to turn on alerts.</span>');
    if (S.pushOn) parts.push(`<span class="small ok">${alertWord()[0].toUpperCase() + alertWord().slice(1)} are on for this device.</span>`);
    else if (canPush && !(isIos && !standalone)) parts.push(`<button class="btn btn--paver sm" data-act="alerts">Turn on ${alertWord()} on this device</button>`);
    return parts.length ? `<div class="alerts">${parts.join('')}</div>` : '';
  };
  async function syncPush() {
    if (!canPush || !S.me || S.me.role === 'client' || S.me.mustChange || Notification.permission !== 'granted') return;
    const reg = await navigator.serviceWorker.ready; const sub = await reg.pushManager.getSubscription();
    if (sub) { S.pushOn = true; api('push-subscribe', 'POST', { sub: sub.toJSON() }).catch(() => {}); }
  }

  // ---------- welcome messages and passwords ----------
  const welcomeText = (kind: 'team' | 'client', name: string, email: string, temp: string) => {
    const first = (name || '').trim().split(' ')[0] || 'there', link = location.origin + '/app/';
    return kind === 'client'
      ? `Hi ${first}, this is CGH Operations. Your project page is ready.\n\n1. Open ${link}\n2. Sign in with your email (${email}) and this temporary password: ${temp}\n3. You will be asked to choose your own password.\n\nYour price, dates and job status are all there. Questions? Call ${PHONE}.`
      : `Welcome to the CGH Operations team, ${first}.\n\n1. Open ${link} on your phone.\n2. Sign in with your email (${email}) and this temporary password: ${temp}\n3. You will be asked to choose your own password.\n4. Put the app on your phone. iPhone: open the link in Safari, tap Share, then "Add to Home Screen". Android: tap "Install this app".\n\nThe temporary password works for 14 days. Please do not share your sign-in.`;
  };
  // Opens the phone's Messages app with the note already written. With a number it is addressed; without one the "To" line is left for you.
  const smsHref = (phone: string | undefined, text: string) => { const to = String(phone || '').replace(/[^\d+]/g, ''); return `sms:${to}${isIos ? '&' : '?'}body=${encodeURIComponent(text)}`; };
  const welcomeBox = (w: any) => `<div class="linkbox"><p><b>Send this to ${esc(w.name || 'them')}.</b> The temporary password is shown only once. If it gets lost, press Reset password to make a new one.</p><textarea readonly rows="9" data-welcome>${esc(w.text)}</textarea><p class="row"><button type="button" class="btn btn--line sm" data-act="copy">Copy message</button><a class="btn btn--line sm" href="mailto:${esc(w.email)}?subject=${encodeURIComponent('Your CGH Operations sign-in')}&body=${encodeURIComponent(w.text)}">Email it</a><a class="btn btn--paver sm" href="${esc(smsHref(w.phone, w.text))}">${w.phone ? `Text it to ${esc(w.phone)}` : 'Text it'}</a></p>${w.phone ? '' : '<p class="muted small">Text it opens your Messages with this written out. You fill in who it goes to.</p>'}</div>`;
  const passwordForm = () => `<form data-form="password" class="stack narrow">${field('Current password', 'current', 'password', 'required autocomplete="current-password"')}${field('New password (10 or more letters or numbers)', 'next', 'password', 'required autocomplete="new-password"')}${showPw}<div><button class="btn btn--paver">Change password</button></div><p class="muted small">Changing it signs you out on your other devices.</p></form>`;

  // ---------- signed out ----------
  const authCard = (title: string, lede: string, body: string) => `<div class="authwrap" style="--photo:url('/img/work/${PHOTO.auth}.webp')"><div class="auth"><p class="auth__brand">${BRAND}</p><h1>${title}</h1><p class="lede">${lede}</p>${notes()}${body}<p class="muted small">Trouble signing in? Call <a href="${PHONE_HREF}">${PHONE}</a>.</p></div>${verseFoot('auth')}<p class="motto">For a better future</p></div>`;
  function renderAuth(mode: 'login' | 'first') {
    if (mode === 'first') root.innerHTML = authCard('Choose your own password', 'You signed in with a temporary password. Pick your own to finish. Nobody at CGH can see it.', `<form data-form="firstpw" class="stack">${S.me.name ? '' : field('Your name', 'name', 'text', 'required autocomplete="name"')}${field('New password', 'next', 'password', 'required autocomplete="new-password"')}${showPw}<p class="rule">Make it at least 10 letters or numbers. It cannot be the temporary one.</p><button class="btn btn--paver">Save and continue</button></form><button class="btn btn--line" data-act="logout">Sign out</button>`);
    else root.innerHTML = authCard('Sign in', 'For CGH Operations customers and team. First time here? Use the temporary password you were sent.', `<form data-form="login" class="stack">${field('Email', 'email', 'email', 'required autocomplete="username"')}${field('Password', 'password', 'password', 'required autocomplete="current-password"')}${showPw}<button class="btn btn--paver">Sign in</button></form><details class="forgot"><summary>Forgot your password?</summary><p>Call or text CGH at <a href="${PHONE_HREF}">${PHONE}</a> and ask for a reset. You get a new temporary password and choose your own again.</p></details>`);
  }

  // ---------- customer portal ----------
  const STEPS = ['Quote requested', 'Site visit', 'Firm quote', 'Accepted', 'Scheduled', 'Done'];
  const stepOf = (stage: string) => ({ New: 0, Contacted: 0, 'Site visit set': 1, 'Quote sent': 2, Accepted: 3, Scheduled: 4, Done: 5 })[stage] ?? 0;
  async function renderClient() {
    const { job } = await api('my-job');
    const top = `<header class="top top--solo"><a class="top__brand" href="/">${BRAND}</a><div class="top__right"><button class="btn btn--line sm" data-act="logout">Sign out</button></div></header>`;
    const head = photoHead('client', 'CGH Operations', 'Your project', `Signed in as ${S.me.name}`);
    let body = `<section class="card"><p class="lede">We do not have a project linked to this login yet. Call <a href="${PHONE_HREF}">${PHONE}</a>.</p></section>`;
    if (job) {
      const at = stepOf(job.stage);
      body = `<ol class="track">${STEPS.map((s, i) => `<li class="${i < at ? 'done' : i === at ? 'now' : ''}">${s}</li>`).join('')}</ol>
      <div class="cols">
        ${card(job.firm_price ? 'Your firm quote' : 'Your price range', `<p class="price">${job.firm_price ? money(job.firm_price) : job.est_low ? `${money(job.est_low)} to ${money(job.est_high)}` : 'Coming after the site visit'}</p>
          <p class="muted">${esc(job.job_type || 'Paving')}${job.sqft ? `, about ${Number(job.sqft).toLocaleString('en-US')} sq ft` : ''}${job.city ? `, ${esc(job.city)}` : ''}</p>
          ${job.firm_price && !job.accepted_at ? `<button class="btn btn--paver" data-act="accept">Accept this quote</button><p class="muted small">Accepting tells us to put you on the schedule. We will call to confirm the date.</p>` : ''}
          ${job.accepted_at ? `<p class="ok">You accepted this quote on ${day(job.accepted_at)}. Thank you.</p>` : ''}`)}
        ${card('Dates', `<dl><dt>Site visit</dt><dd>${esc(job.visit_date ? longDay(job.visit_date) : 'Not set yet')}</dd><dt>Paving day</dt><dd>${esc(job.job_date ? longDay(job.job_date) : 'Not set yet')}</dd></dl>
          ${job.status_note ? `<h3>Latest from CGH</h3><p>${esc(job.status_note)}</p>` : ''}<a class="btn btn--line" href="${PHONE_HREF}">Call ${PHONE}</a>`)}
      </div>
      ${card('Caring for new asphalt', '<ul class="plain"><li>Stay off it until we tell you it is ready. Hot weather means a longer wait.</li><li>For the first few weeks, avoid turning your wheels while parked and keep kickstands, jacks and trailer tongues off it.</li><li>Keep the edges supported. Do not drive off the side of the pavement.</li><li>Ask us when it is time to sealcoat. New asphalt has to cure first.</li></ul>')}`;
    }
    root.innerHTML = `<div class="solo">${top}<main class="page"><div class="stack">${head}${notes()}${body}<details class="card fold" ${S.acct ? 'open' : ''}><summary>Change my password</summary>${passwordForm()}</details>${verseFoot('client')}</div></main></div>`;
  }

  // ---------- map drawings ----------
  // "2 areas and 1 traced drive, 1,850 sq ft"
  const mapWords = (m: any) => { if (!m?.shapes?.length) return ''; const a = m.shapes.filter((x: any) => x.kind !== 'line').length, d = m.shapes.length - a; return `${[a ? plural(a, 'area', 'areas') : '', d ? plural(d, 'traced drive', 'traced drives') : ''].filter(Boolean).join(' and ')}, ${Number(m.sqft || 0).toLocaleString('en-US')} sq ft`; };
  // The satellite map is only downloaded the first time someone opens it.
  const openMap = async (o: any) => (await import('../lib/mapdraw')).openMapDraw({ staff: true, ...o });
  // On a lead or job: what was drawn, a button to open it, and (when the drawing and the job size disagree) a button to take the drawing's size.
  const mapRow = (l: any) => {
    const crew = S.me.role === 'crew', m = l.map;
    if (!m && crew) return '';
    const differs = m && !crew && m.sqft >= 1 && Math.abs(m.sqft - (l.sqft || 0)) > 2;
    return `<div class="maprow">${m ? `<p class="small"><b>On the map:</b> ${esc(mapWords(m))}${m.address ? ` · ${esc(m.address)}` : ''}${m.by ? ` · measured by ${esc(m.by)}` : ' · drawn by the customer'}</p>` : ''}
      <div class="row"><button type="button" class="btn btn--line sm" data-act="map" data-id="${l.id}">${icon('measure')} ${m ? (crew ? 'See it on the map' : 'Open the job map') : 'Draw this job on the map'}</button>
      ${differs ? `<button type="button" class="btn btn--line sm" data-act="mapsize" data-id="${l.id}">Use ${Number(m.sqft).toLocaleString('en-US')} sq ft as the job size</button>` : ''}
      ${m && m.shapes?.[0]?.pts?.[0] ? `<a class="btn btn--line sm" target="_blank" rel="noopener" href="https://www.google.com/maps/dir/?api=1&destination=${Number(m.shapes[0].pts[0][0])},${Number(m.shapes[0].pts[0][1])}">Directions</a>` : ''}</div>
      ${differs ? `<p class="muted small">The drawing is ${Number(m.sqft).toLocaleString('en-US')} sq ft. The job is on file at ${Number(l.sqft || 0).toLocaleString('en-US')} sq ft.</p>` : ''}</div>`;
  };

  // ---------- leads (used by Pipeline and Jobs) ----------
  const hit = (l: any) => !S.q || [l.name, l.city, l.phone, l.email, l.job_type].join(' ').toLowerCase().includes(S.q.toLowerCase());
  const stagePill = (s: string) => `<span class="stage s-${s.replace(/\W/g, '')}">${esc(s)}</span>`;
  function leadCard(l: any, d: any) {
    const crew = S.me.role === 'crew';
    const range = l.firm_price ? money(l.firm_price) + ' firm' : l.est_low ? `${money(l.est_low)} to ${money(l.est_high)}` : '';
    const sel = (name: string, opts: [string, string][], cur: string) => `<select name="${name}">${opts.map(([v, t]) => `<option value="${esc(v)}" ${v === (cur ?? '') ? 'selected' : ''}>${esc(t)}</option>`).join('')}</select>`;
    return `<details class="lead" ${S.open === l.id ? 'open' : ''} data-id="${l.id}">
      <summary>${stagePill(l.stage)}<b>${esc(l.name)}</b><span class="muted">${l.stage === 'New' && Date.now() - l.created > 864e5 ? `<strong class="want">Waiting ${plural(Math.floor((Date.now() - l.created) / 864e5), 'day', 'days')}</strong> · ` : ''}${l.follow_up && !['Done', 'Lost'].includes(l.stage) ? `<strong class="${l.follow_up <= today() ? 'want' : ''}">Follow up ${esc(shortDay(l.follow_up))}</strong> · ` : ''}${l.request ? `<strong class="want">Wants ${l.request.want === 'call' ? 'a call' : 'a site visit'}${l.request.when ? ` (${esc(l.request.when)})` : ''}</strong> · ` : ''}${esc(l.job_type || '')}${l.sqft ? ` · ${Number(l.sqft).toLocaleString('en-US')} sq ft` : ''}${l.city ? ` · ${esc(l.city)}` : ''}</span><span class="amt">${range}${l.options && !l.firm_price ? ` <small>Economy</small>` : ''}</span><span class="muted small">${l.job_date ? esc(longDay(l.job_date)) : day(l.created)}</span></summary>
      <div class="lead__body">
        <p class="contact">${l.phone ? `<a class="btn btn--paver" href="tel:${esc(l.phone)}">Call ${esc(l.phone)}</a><a class="btn btn--line" href="sms:${esc(l.phone)}">Text</a>` : ''}${l.email ? `<a class="btn btn--line" href="mailto:${esc(l.email)}">Email</a>` : ''}</p>
        <p class="muted small">${l.base_work ? `Needs grading: ${esc(l.base_work)}. ` : ''}${l.fill_pct ? `Rock on about ${l.fill_pct}% (${l.loads} load${l.loads === 1 ? '' : 's'}). ` : ''}${l.job_date ? `Paving day: ${esc(longDay(l.job_date))}. ` : ''}${l.source ? `Source: ${esc(l.source)}.` : ''}</p>
        ${l.options ? `<p class="small">${l.options.map((o: any) => `<b>${esc(o.name)}</b> ${money(o.low)} to ${money(o.high)}`).join(' · ')}${l.request?.option ? ` · <strong class="want">Leaning ${esc(l.request.option)}</strong>` : ''}</p>` : ''}
        ${mapRow(l)}
        ${l.sqft ? `<p class="muted small">Materials at 2 inches thick: about ${tons(l.sqft)} tons of hot mix${l.loads ? `, plus ${plural(l.loads, 'load', 'loads')} of rock` : ''}.</p>` : ''}
        ${['Accepted', 'Scheduled', 'Done'].includes(l.stage) && d.checks ? `<div><p class="eyebrow">Job-day checklist</p><div class="checks">${d.checks.map((c: string) => `<button type="button" class="chk ${l.checklist?.[c] ? 'on' : ''}" data-act="check" data-id="${l.id}" data-item="${esc(c)}" data-done="${l.checklist?.[c] ? '' : '1'}" ${l.checklist?.[c] ? `title="${esc(l.checklist[c].by)}, ${day(l.checklist[c].at)}"` : ''}>${l.checklist?.[c] ? '✓ ' : ''}${esc(c)}</button>`).join('')}</div></div>
        <form data-form="joblog" data-id="${l.id}" class="joblog"><input name="text" placeholder="Add a job note: what was done, what came up" required aria-label="Job note" /><button class="btn btn--line sm">Add note</button></form>
        ${l.joblog?.length ? `<ul class="notes">${l.joblog.slice(0, 6).map((n: any) => `<li><span class="muted small">${day(n.at)} · ${esc(n.by)}</span><br />${esc(n.text)}</li>`).join('')}</ul>` : ''}` : ''}
        ${crew ? '' : `<form data-form="lead" data-id="${l.id}" class="grid2">
          <div class="field"><label>Stage${sel('stage', d.stages.map((s: string) => [s, s]), l.stage)}</label></div>
          ${BOSS.includes(S.me.role) ? `<div class="field"><label>Assigned to${sel('owner', [['', 'Nobody yet'], ...d.team.map((u: any) => [u.id, u.name])], l.owner)}</label></div>` : ''}
          <div class="field"><label>Firm price ($)<input name="firm_price" inputmode="decimal" value="${l.firm_price || ''}" /></label></div>
          <div class="field"><label>Customer email<input name="email" type="email" value="${esc(l.email || '')}" /></label></div>
          <div class="field"><label>Site visit<input name="visit_date" type="date" value="${esc(l.visit_date || '')}" /></label></div>
          <div class="field"><label>Paving day<input name="job_date" type="date" value="${esc(l.job_date || '')}" /></label></div>
          <div class="field"><label>Follow up on<input name="follow_up" type="date" value="${esc(l.follow_up || '')}" /></label></div>
          <div class="field full"><label>Message the customer sees in their portal<textarea name="status_note">${esc(l.status_note || '')}</textarea></label></div>
          <div class="field full"><label>Add a note (team only)<textarea name="note" placeholder="What was said, what is next"></textarea></label></div>
          <div class="full row"><button class="btn btn--paver">Save</button><button type="button" class="btn btn--line" data-act="client" data-id="${l.id}">${l.clientUid ? 'Reset customer password' : 'Create customer login'}</button></div>
          ${S.welcome && S.welcome.for === l.id ? `<div class="full">${welcomeBox(S.welcome)}</div>` : ''}
        </form>
        ${l.notes?.length ? `<ul class="notes">${l.notes.slice().reverse().map((n: any) => `<li><span class="muted small">${day(n.at)} · ${esc(n.by)}</span><br />${esc(n.text)}</li>`).join('')}</ul>` : ''}`}
      </div></details>`;
  }
  const newLeadForm = () => `<details class="card fold" ${S.adding ? 'open' : ''}><summary>Add a lead</summary><form data-form="newlead" class="grid2">${field('Name', 'name', 'text', 'required')}${field('Phone', 'phone', 'tel')}${field('Email', 'email', 'email')}${field('Town or address', 'city')}${field('Job (driveway, lot, road…)', 'job_type')}${field('Square feet', 'sqft', 'text', 'inputmode="numeric"')}<div class="field full"><label>Note<textarea name="note"></textarea></label></div><input type="hidden" name="source" value="added by team" /><div class="full"><button class="btn btn--paver">Save lead</button></div></form></details>`;

  // ---------- the pages ----------
  type Page = { eyebrow: string; title: string; sub?: string; actions?: string; body: string };
  const PAGES: Record<string, () => Promise<Page>> = {
    async home() {
      const d = await api('home?today=' + today()); const w = d.waiting, role = S.me.role as Role;
      const h = new Date().getHours(), first = (S.me.name || '').split(' ')[0];
      const rows: [string, string, string][] = []; // tone, text, where it goes
      if (w.followups) rows.push(['hot', `${plural(w.followups, 'follow-up is', 'follow-ups are')} due`, 'pipeline:Open']);
      if (w.asked) rows.push(['hot', `${plural(w.asked, 'customer', 'customers')} asked for a call or site visit`, 'pipeline:New']);
      if (w.fresh) rows.push(['warn', `${plural(w.fresh, 'new lead', 'new leads')} to call`, 'pipeline:New']);
      if (w.quoted) rows.push(['warn', `${plural(w.quoted, 'firm quote', 'firm quotes')} waiting on the customer`, 'pipeline:Quote sent']);
      if (w.unscheduled) rows.push(['warn', `${plural(w.unscheduled, 'accepted job needs', 'accepted jobs need')} a paving day`, 'pipeline:Accepted']);
      if (w.applicants) rows.push(['warn', `${plural(w.applicants, 'new job application', 'new job applications')}`, 'hiring']);
      if (w.notSignedIn) rows.push(['calm', `${plural(w.notSignedIn, 'team login has', 'team logins have')} not been used yet`, 'team']);
      if (w.lessons) rows.push(['calm', `${plural(w.lessons, 'training lesson', 'training lessons')} left for you`, 'training']);
      const total = rows.length;
      const coming = d.dated.filter((x: any) => x.date >= today()).slice(0, 6);
      // Owner and managers: how far website visitors get through the quote, so it is plain where they stop.
      const web = BOSS.includes(role) ? await api('stats').catch(() => null) : null;
      const funnel = () => {
        const steps: [string, string][] = [['visit', 'Visited the website'], ['quote_start', 'Started a quote'], ['quote_ground', 'Got to the second step'], ['quote_priced', 'Saw a price'], ['quote_request', 'Sent it in (a lead)']];
        const pct = (n: number, of: number) => (of ? ` <span class="muted small">${Math.round((n / of) * 100)}%</span>` : '');
        const row = (label: string, a: number, a0: number, b: number, b0: number) => `<tr><th scope="row">${label}</th><td>${a.toLocaleString('en-US')}${pct(a, a0)}</td><td>${b.toLocaleString('en-US')}${pct(b, b0)}</td></tr>`;
        return `<table class="lines web"><thead><tr><th></th><th>7 days</th><th>30 days</th></tr></thead><tbody>${steps.map(([k, label], i) => row(label, web.d7[k] || 0, i ? web.d7.visit || 0 : 0, web.d30[k] || 0, i ? web.d30.visit || 0 : 0)).join('')}${row('Opened the map', web.d7.map_open || 0, 0, web.d30.map_open || 0, 0)}${row('Used the map for their size', web.d7.map_used || 0, 0, web.d30.map_used || 0, 0)}${row('Tapped the phone number', web.d7.call_tap || 0, 0, web.d30.call_tap || 0, 0)}</tbody></table><p class="muted small">${web.since ? `Counting since ${esc(shortDay(web.since))}.` : 'Counting starts with the next visitor.'} Each person is counted once per step per visit. Percentages are out of everyone who visited. No names are attached.</p>`;
      };
      const next = role === 'crew' ? coming[0] : null;
      return {
        eyebrow: new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' }),
        title: `Good ${h < 12 ? 'morning' : h < 17 ? 'afternoon' : 'evening'}${first ? ', ' + first : ''}.`,
        sub: BOSS.includes(role) ? 'Here is the whole company today.' : role === 'sales' ? 'Here is your pipeline today.' : 'Here is what is coming up.',
        actions: role === 'crew' ? '' : '<button class="btn btn--paver" data-go="quote">+ Quick quote</button><button class="btn btn--line" data-go="pipeline:add">+ New lead</button>',
        body: `${S.pushOn ? '' : alertsBar()}
          ${d.stats ? `<div class="stats"><div><b>${d.stats.priced || 0}</b><span>${d.stats.priced === 1 ? 'price' : 'prices'} looked at on the website this week</span></div><div><b>${d.stats.week}</b><span>new ${d.stats.week === 1 ? 'lead' : 'leads'} this week</span></div><div><b>${money(d.stats.quoted) || '$0'}</b><span>quoted, waiting on an answer</span></div><div><b>${money(d.stats.booked) || '$0'}</b><span>booked work</span></div></div>` : ''}
          ${next ? card('Your next job', `<div class="nextjob"><p class="eyebrow">${esc(longDay(next.date))}</p><p class="big">${esc(next.name)}</p><p class="muted">${esc([next.job_type, next.sqft ? Number(next.sqft).toLocaleString('en-US') + ' sq ft' : '', next.city].filter(Boolean).join(' · '))}</p>${next.phone ? `<a class="btn btn--paver" href="tel:${esc(next.phone)}">${icon('phone')} Call the customer</a>` : ''}</div>`, '<button class="link" data-go="jobs">All jobs →</button>') : ''}
          ${card(`Waiting on you ${total ? `<span class="pill">${total}</span>` : ''}`, total ? `<ul class="rows">${rows.map(([tone, text, go]) => `<li><button class="rowbtn t-${tone}" data-go="${go}"><span>${esc(text)}</span><i>›</i></button></li>`).join('')}</ul>` : '<p class="empty">Nothing is waiting on you right now.</p>')}
          ${card(`${icon('announcements')} Announcements`, d.announcements.length ? `<ul class="rows">${d.announcements.map((a: any) => `<li><details class="ann"><summary><b>${esc(a.title)}</b><span class="muted small">${day(a.at)} · ${esc(a.by)}</span></summary><p>${esc(a.body)}</p></details></li>`).join('')}</ul>` : `<p class="empty">No announcements yet.${role === 'owner' ? ' Post one from Announcements and the whole team sees it here.' : ''}</p>`, '<button class="link" data-go="announcements">All →</button>')}
          ${web ? card('Where website visitors stop', funnel()) : ''}
          ${card('Coming up', coming.length ? `<ul class="rows">${coming.map((x: any) => `<li class="when"><span class="when__d">${esc(longDay(x.date))}</span><span class="tag ${x.kind === 'Paving day' ? 'tag--pave' : ''}">${x.kind}</span><b>${esc(x.name)}</b><span class="muted">${esc(x.city || '')}</span></li>`).join('')}</ul>` : '<p class="empty">Nothing on the calendar yet. Site visits and paving days show here once a lead has a date.</p>', '<button class="link" data-go="schedule">Schedule →</button>')}`,
      };
    },
    async schedule() {
      const d = await api('home?today=' + today()); const coming = d.dated.filter((x: any) => x.date >= today());
      const days: Record<string, any[]> = {}; coming.forEach((x: any) => (days[x.date] ||= []).push(x));
      return { eyebrow: 'Today', title: 'Schedule', sub: S.me.role === 'crew' ? 'Paving days you are on.' : 'Site visits and paving days, soonest first.',
        body: Object.keys(days).length ? Object.entries(days).map(([date, list]) => card(`${date === today() ? 'Today · ' : ''}${esc(longDay(date))}`, `<ul class="rows">${list.map((x: any) => `<li class="when"><span class="tag ${x.kind === 'Paving day' ? 'tag--pave' : ''}">${x.kind}</span><b>${esc(x.name)}</b><span class="muted">${esc([x.job_type, x.city].filter(Boolean).join(' · '))}</span>${x.phone ? `<a class="btn btn--line sm" href="tel:${esc(x.phone)}">Call</a>` : ''}</li>`).join('')}</ul>`)).join('') : `<p class="empty">Nothing is scheduled yet. ${S.me.role === 'crew' ? 'Jobs show here once they have a paving day.' : 'Open a lead in Pipeline and set a site visit or paving day.'}</p>` };
    },
    async jobs() {
      const d = await api('leads'); S.data = d;
      const jobs = d.leads.filter((l: any) => ['Accepted', 'Scheduled', 'Done'].includes(l.stage)).filter(hit).sort((a: any, b: any) => (a.job_date || '9999').localeCompare(b.job_date || '9999'));
      const live = jobs.filter((l: any) => l.stage !== 'Done'), done = jobs.filter((l: any) => l.stage === 'Done');
      return { eyebrow: 'Today', title: 'Jobs', sub: 'Sold work: waiting for a date, on the schedule, and finished.',
        body: (live.length ? live.map((l: any) => leadCard(l, d)).join('') : '<p class="empty">No open jobs yet. A lead becomes a job when the customer accepts the quote.</p>') + (done.length ? `<h2 class="sep">Finished</h2>${done.map((l: any) => leadCard(l, d)).join('')}` : '') };
    },
    async pipeline() {
      const d = await api('leads'); S.data = d;
      const open = (l: any) => !['Done', 'Lost'].includes(l.stage);
      const filters = ['Open', ...d.stages];
      const pool = d.leads.filter(hit);
      const shown = pool.filter((l: any) => (S.filter === 'Open' ? open(l) : l.stage === S.filter));
      return { eyebrow: 'Sales', title: 'Pipeline', sub: 'Every lead, from first call to finished job.', actions: `<button class="btn btn--paver" data-go="quote">+ Quick quote</button>${BOSS.includes(S.me.role) ? '<button class="btn btn--line" data-act="csv">Download list</button>' : ''}`,
        body: `${newLeadForm()}<div class="chips">${filters.map((f) => `<button data-filter="${esc(f)}" class="${S.filter === f ? 'on' : ''}">${esc(f)} <span>${pool.filter((l: any) => (f === 'Open' ? open(l) : l.stage === f)).length}</span></button>`).join('')}</div>
          ${shown.length ? shown.map((l: any) => leadCard(l, d)).join('') : `<p class="empty">${S.q ? 'No leads match that search.' : 'Nothing here yet. Website quotes land here automatically, or add a lead above.'}</p>`}` };
    },
    async customers() {
      const d = await api('leads'); S.data = d;
      const list = d.leads.filter((l: any) => ['Accepted', 'Scheduled', 'Done'].includes(l.stage)).filter(hit);
      return { eyebrow: 'Sales', title: 'Customers', sub: 'Everyone who has said yes.',
        body: list.length ? `<div class="tblwrap"><table class="tbl"><thead><tr><th>Customer</th><th>Job</th><th>Price</th><th>Status</th><th></th></tr></thead><tbody>${list.map((l: any) => `<tr><td><b>${esc(l.name)}</b><br /><span class="muted small">${esc(l.city || '')}</span></td><td>${esc(l.job_type || '')}${l.sqft ? `<br /><span class="muted small">${Number(l.sqft).toLocaleString('en-US')} sq ft</span>` : ''}</td><td>${money(l.firm_price) || '—'}</td><td>${stagePill(l.stage)}</td><td>${l.phone ? `<a class="btn btn--line sm" href="tel:${esc(l.phone)}">Call</a>` : ''} <button class="btn btn--line sm" data-go="pipeline:open:${l.id}">Open</button></td></tr>`).join('')}</tbody></table></div>` : `<p class="empty">${S.q ? 'No customers match that search.' : 'No customers yet. They show here once a quote is accepted.'}</p>` };
    },
    async quote() {
      S.pricing = S.pricing || ((await api('pricing')).prices as Pricing); // prices arrive only after sign-in
      return { eyebrow: 'Sales', title: 'Quick quote', sub: 'Same prices as the website. Price it on the spot, then save it as a lead.',
        body: `<div class="cols">${card('The job', `<form data-form="quickquote" class="grid2">${field('Customer name', 'name', 'text', 'required')}${field('Phone', 'phone', 'tel')}${field('Town or address', 'city')}${field('Job (driveway, lot, road…)', 'job_type', 'text', 'value="Driveway"')}${field('Length (ft)', 'length', 'text', 'inputmode="decimal"')}${field('Width (ft)', 'width', 'text', 'inputmode="decimal"')}${field('Or total square feet', 'sqft', 'text', 'inputmode="numeric"')}<div class="field"><label>Grading or washout repair<select name="base_work"><option>No</option><option>Yes</option></select></label></div><div class="field full"><label>How much of it needs rock? <b data-qq="fill">None</b><input name="fill_pct" type="range" min="0" max="100" step="5" value="0" /></label></div><div class="full"><button class="btn btn--paver">Save as a lead</button></div></form>`)}
          ${card('Price', `<p class="price" data-qq="range">Enter a size</p><table class="lines"><tbody data-qq="lines"></tbody></table><p class="muted small">A ballpark before taxes or permits. Confirm it on site before you promise it.</p>`)}</div>` };
    },
    async announcements() {
      const { announcements } = await api('announcements'); const boss = BOSS.includes(S.me.role);
      return { eyebrow: 'Team', title: 'Announcements', sub: boss ? 'Post once and the whole team sees it, with an alert on their phone.' : 'From the office to the whole team.',
        body: `${boss ? card('New announcement', `<form data-form="announce" class="stack">${field('Title', 'title', 'text', 'required maxlength="120"')}<div class="field"><label>Message<textarea name="body" rows="4"></textarea></label></div><div><button class="btn btn--paver">Post to the team</button></div></form>`) : ''}
          ${announcements.length ? announcements.map((a: any) => `<section class="card"><div class="card__head"><h2>${esc(a.title)}</h2><span class="muted small">${day(a.at)} · ${esc(a.by)}</span></div><p class="pre">${esc(a.body)}</p>${boss ? `<button class="btn btn--line sm" data-act="anndel" data-id="${a.id}">${S.confirm === a.id ? 'Tap again to remove' : 'Remove'}</button>` : ''}</section>`).join('') : '<p class="empty">No announcements yet.</p>'}` };
    },
    async training() {
      const d = await api('training'); const count = d.lessons.filter((l: any) => d.done[l.id]).length;
      return { eyebrow: 'Team', title: 'Training', sub: `${count} of ${d.lessons.length} lessons done.`,
        body: `${d.lessons.map((l: any) => `<details class="lead"><summary><span class="stage ${d.done[l.id] ? 's-Done' : ''}">${d.done[l.id] ? 'Done' : 'To do'}</span><b>${esc(l.title)}</b><span class="muted">${l.minutes} min</span><span class="amt"></span><span></span></summary><div class="lead__body"><ul class="plain">${l.points.map((p: string) => `<li>${esc(p)}</li>`).join('')}</ul>${d.done[l.id] ? `<p class="ok">You finished this on ${day(d.done[l.id])}.</p>` : `<div><button class="btn btn--paver" data-act="lesson" data-id="${l.id}">I have read and understand this</button></div>`}</div></details>`).join('')}
          ${d.team ? `<h2 class="sep">Team progress</h2><div class="tblwrap"><table class="tbl"><thead><tr><th>Name</th>${d.lessons.map((l: any) => `<th title="${esc(l.title)}">${esc(l.title.split(' ').slice(0, 2).join(' '))}</th>`).join('')}</tr></thead><tbody>${d.team.map((t: any) => `<tr><td><b>${esc(t.name)}</b></td>${d.lessons.map((l: any) => `<td>${t.done[l.id] ? 'Done' : ''}</td>`).join('')}</tr>`).join('')}</tbody></table></div>` : ''}` };
    },
    async team() {
      const { users } = await api('users');
      return { eyebrow: 'Team', title: 'Team', sub: 'Who can sign in, and what they can see.',
        body: `<details class="card fold" ${S.welcome && S.welcome.for === 'team' ? 'open' : ''}><summary>Add a team member</summary><form data-form="newuser" class="grid2">${field('Name', 'name', 'text', 'required')}${field('Email', 'email', 'email', 'required')}${field('Cell phone (optional, for texting their sign-in)', 'phone', 'tel')}<div class="field"><label>Role<select name="role">${(S.me.role === ('owner' as Role) ? ['manager', 'sales', 'crew'] : ['sales', 'crew']).map((r) => `<option value="${r}" ${r === 'sales' ? 'selected' : ''}>${ROLE_WORDS[r]}</option>`).join('')}</select></label></div><div class="full"><button class="btn btn--paver">Create login</button></div></form>${S.welcome && S.welcome.for === 'team' ? welcomeBox(S.welcome) : ''}</details>
          <div class="tblwrap"><table class="tbl"><thead><tr><th>Name</th><th>Role</th><th>Status</th><th></th></tr></thead><tbody>${users.map((u: any) => `<tr><td><b>${esc(u.name)}</b><br /><span class="muted small">${esc(u.email)}</span></td><td>${S.me.role === ('owner' as Role) && ['manager', 'sales', 'crew'].includes(u.role) ? `<select data-role-for="${u.id}" aria-label="Role for ${esc(u.name)}">${['manager', 'sales', 'crew'].map((r) => `<option value="${r}" ${r === u.role ? 'selected' : ''}>${r[0].toUpperCase() + r.slice(1)}</option>`).join('')}</select>` : u.role}</td><td>${u.disabled ? 'Turned off' : u.active ? 'Active' : 'Has not signed in yet'}</td><td>${u.role === 'owner' || (u.role === 'manager' && S.me.role !== ('owner' as Role)) ? '' : `<button class="btn btn--line sm" data-act="relink" data-id="${u.id}" data-name="${esc(u.name)}" data-email="${esc(u.email)}" data-phone="${esc(u.phone || '')}" data-kind="${u.role === 'client' ? 'client' : 'team'}">Reset password</button> <button class="btn btn--line sm" data-act="toggle" data-id="${u.id}" data-off="${u.disabled ? '' : '1'}">${u.disabled ? 'Turn on' : 'Turn off'}</button>`}</td></tr>`).join('')}</tbody></table></div>` };
    },
    async hiring() {
      const { applicants } = await api('applicants');
      return { eyebrow: 'Team', title: 'Hiring', sub: 'Applications from the Careers page.',
        body: applicants.length ? applicants.map((a: any) => `<details class="lead" ${S.open === a.id ? 'open' : ''}><summary><span class="stage ${a.status === 'New' ? 's-New' : ''}">${esc(a.status)}</span><b>${esc(a.name)}</b><span class="muted">${esc(a.position || '')}${a.city ? ` · ${esc(a.city)}` : ''}</span><span class="amt"></span><span class="muted small">${day(a.created)}</span></summary><div class="lead__body"><p class="contact"><a class="btn btn--paver" href="tel:${esc(a.phone)}">Call ${esc(a.phone)}</a>${a.email ? `<a class="btn btn--line" href="mailto:${esc(a.email)}">Email</a>` : ''}</p><p class="muted small">CDL: ${esc(a.cdl || 'not given')}. Experience: ${esc(a.experience_years || 'not given')}. Can start: ${esc(a.start || 'not given')}.</p><p>${esc(a.details || '')}</p><form data-form="applicant" data-id="${a.id}" class="row"><select name="status">${['New', 'Called', 'Interview', 'Hired', 'Not a fit'].map((s) => `<option ${s === a.status ? 'selected' : ''}>${s}</option>`).join('')}</select><button class="btn btn--paver">Save</button></form>
          <form data-form="hire" data-id="${a.id}" data-name="${esc(a.name)}" data-phone="${esc(a.phone)}" class="grid2 hire"><p class="eyebrow full">Hiring ${esc(a.name.split(' ')[0])}? Make their app login</p>${field('Their email', 'email', 'email', `required value="${esc(a.email || '')}"`)}<div class="field"><label>Role<select name="role">${(S.me.role === ('owner' as Role) ? ['crew', 'sales', 'manager'] : ['crew', 'sales']).map((r) => `<option value="${r}">${ROLE_WORDS[r]}</option>`).join('')}</select></label></div><div class="full"><button class="btn btn--line">Create login and text it to ${esc(a.phone)}</button></div></form>
          ${S.welcome && S.welcome.for === 'hire-' + a.id ? welcomeBox(S.welcome) : ''}</div></details>`).join('') : '<p class="empty">No applications yet. They arrive here from the Careers page.</p>' };
    },
    async equipment() {
