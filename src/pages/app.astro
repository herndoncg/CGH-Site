          ${LAYERS.map(([id, name, what, tpy, truck, hint]) => `<details class="lead" ${m[id]?.on ? 'open' : ''}><summary><span class="stage" data-mat="${id}-tag">Not counted</span><b>${name}</b><span class="muted">${what}</span><span class="amt" data-mat="${id}-amt"></span><span></span></summary><div class="lead__body"><div class="grid2">${n('Square feet', id + '.sqft', v(id, 'sqft'))}${n('Depth laid, inches', id + '.depth', v(id, 'depth'))}${n('$ per ton', id + '.perTon', v(id, 'perTon'), hint)}${n('Tons in one cubic yard', id + '.tonsPerYard', v(id, 'tonsPerYard', tpy))}${n('Dump truck holds, tons', id + '.truckTons', v(id, 'truckTons', truck))}</div><div class="row">${tick(id + '.on', 'Count this in the total', !!m[id]?.on)}${tick(id + '.exempt', 'Tax exempt', !!m[id]?.exempt)}</div><table class="lines"><tbody data-mat="${id}"></tbody></table></div></details>`).join('')}
          ${LIQ.map(([id, name, what, rate, waste, rhint, chint]) => `<details class="lead" ${m[id]?.on ? 'open' : ''}><summary><span class="stage" data-mat="${id}-tag">Not counted</span><b>${name}</b><span class="muted">${what}</span><span class="amt" data-mat="${id}-amt"></span><span></span></summary><div class="lead__body"><div class="grid2">${n('Square feet', id + '.sqft', v(id, 'sqft'))}${n('Gallons per square yard', id + '.rate', v(id, 'rate', rate), rhint)}${n('$ per gallon', id + '.perGal', v(id, 'perGal'), chint)}${n('Wastage %', id + '.wastePct', v(id, 'wastePct', waste), 'Average 5 to 10')}</div><div class="row">${tick(id + '.on', 'Count this in the total', !!m[id]?.on)}${tick(id + '.exempt', 'Tax exempt', !!m[id]?.exempt)}</div><table class="lines"><tbody data-mat="${id}"></tbody></table></div></details>`).join('')}</form>` };
    },
    async guide() {
      const q = (S.gq || '').toLowerCase(); const has = (o: object) => !q || Object.values(o).join(' ').toLowerCase().includes(q);
      const row = (k: string, val: unknown) => (val ? `<tr><th scope="row">${k}</th><td>${esc(val)}</td></tr>` : '');
      const A = (guide as any).asphalt.filter(has), B = (guide as any).base.filter(has), L = (guide as any).liquids.filter(has);
      const sec = (title: string, n: number, html: string) => (n ? `<h2 class="sep">${title} <span class="pill">${n}</span></h2>${html}` : '');
      return { eyebrow: 'Team', title: 'Field guide', sub: 'Asphalt types, base rock and liquid coats. Search it while you are standing with the customer.',
        body: `<label class="search search--wide">${icon('search')}<input data-gsearch type="search" placeholder="Search: tack coat, limestone, cure time, Type D…" value="${esc(S.gq || '')}" aria-label="Search the field guide" /></label>
          ${sec('Asphalt types', A.length, A.map((x: any) => `<details class="lead"><summary><span class="stage s-New">${esc(x.type)}</span><b>${esc(x.layer)}</b><span class="muted">${esc(x.thickness)} thick · ${esc(x.use)}</span><span class="amt"></span><span></span></summary><div class="lead__body"><table class="lines guide"><tbody>${row('Rock size', x.aggregate)}${row('Common thickness', x.thickness)}${row('Used for', x.use)}${row('Surface', x.surface)}${row('Strength', x.strength)}${row('Notes', x.notes)}</tbody></table></div></details>`).join(''))}
          ${sec('Road base and rock', B.length, B.map((x: any) => `<details class="lead"><summary><span class="stage">Base</span><b>${esc(x.name)}</b><span class="muted">Compacts ${esc(x.compaction)} · cars ${esc(x.cars)} in</span><span class="amt"></span><span></span></summary><div class="lead__body"><table class="lines guide"><tbody>${row('Compaction', x.compaction)}${row('Cars and light trucks, inches', x.cars)}${row('Light commercial and vans, inches', x.light)}${row('Heavy trucks and RVs, inches', x.heavy)}${row('Semis and industrial, inches', x.semi)}${row('As the driving surface (no asphalt on top)', x.direct)}${row('Good', x.pros)}${row('Watch for', x.cons)}${row('When to use it', x.when)}${row('How long it lasts in East Texas', x.life)}${row('In the field', x.field)}</tbody></table></div></details>`).join(''))}
          ${sec('Primers, tack coats and seal coats', L.length, L.map((x: any) => `<details class="lead"><summary><span class="stage ${x.applied === 'Hot' ? 's-warn' : 's-Accepted'}">${esc(x.applied)}</span><b>${esc(x.product)}</b><span class="muted">${esc(x.kind)} · ${esc(x.rate)} gal per sq yd · sets in ${esc(x.set)}</span><span class="amt"></span><span></span></summary><div class="lead__body"><table class="lines guide"><tbody>${row('Full name', x.full)}${row('What it is', x.kind)}${row('Gallons per square yard', x.rate)}${row('Typical cost per gallon', x.cost)}${row('Typical wastage', x.waste)}${row('Product temperature', x.productTemp)}${row('Outside temperature', x.outside)}${row('How it goes down', x.method)}${row('Set time', x.set)}${row('Reapply', x.reapply)}${row('Coverage', x.coverage)}${row('Cure', x.cure)}${row('Used for', x.use)}${row('Warnings', x.warn)}${row('Ease / effectiveness / crew-friendly (out of 5)', `${x.ease} / ${x.effect} / ${x.friendly}`)}</tbody></table></div></details>`).join(''))}
          ${A.length + B.length + L.length ? '' : '<p class="empty">Nothing in the guide matches that. Try a shorter word.</p>'}` };
    },
    async measure() {
      const m = S.measure, sell = SELL.includes(S.me.role);
      const depth = S.measureDepth || 4, sq = m?.sqft || 0;
      const rock = sq ? yardage({ sqft: sq, depth, compactionPct: 0, yardsPerLoad: 10 }) : null;
      const rows = (m?.shapes || []).map((x: any, i: number) => `<tr><th scope="row">${x.kind === 'line' ? 'Drive' : 'Area'} ${i + 1}</th><td>${x.kind === 'line' ? `${Number(x.ft).toLocaleString('en-US')} ft long${x.width_ft ? ` × ${Number(x.width_ft)} ft` : ''}` : `${Number(x.ft).toLocaleString('en-US')} ft around`}</td><td>${x.sqft ? `${Number(x.sqft).toLocaleString('en-US')} sq ft` : ''}</td></tr>`).join('');
      return { eyebrow: 'Shop', title: 'Measure on a map', sub: 'Find the place on the satellite map, tap the corners, and get square feet, tons and loads.',
        body: `${card('The map', `<p class="muted">Type the address, then tap a dot on each corner of the area. For a long drive, tap along the middle and pick the width. Drag any dot to fix it.</p><div class="row"><button class="btn btn--paver" data-act="measure">${icon('measure')} ${m ? 'Change the drawing' : 'Open the map'}</button>${m ? '<button class="btn btn--line" data-act="measureclear">Clear it</button>' : ''}</div>`)}
          ${m ? `<div class="cols">${card('What you drew', `<p class="price">${sq.toLocaleString('en-US')} sq ft</p><p class="muted">${dec(sq / 9, 1)} square yards${m.address ? ` · ${esc(m.address)}` : ''}</p><table class="lines"><tbody>${rows}</tbody></table>`)}
            ${card('Materials for that', sq ? `<table class="lines"><tbody><tr><th scope="row">Hot mix at 2 inches</th><td>${tons(sq, 2)} tons</td></tr><tr><th scope="row">Hot mix at 3 inches</th><td>${tons(sq, 3)} tons</td></tr><tr><th scope="row">Rock at ${depth} inches</th><td>${dec(rock!.yards, 1)} cubic yards, ${plural(rock!.loads, 'load', 'loads')}</td></tr></tbody></table><div class="chips">${[2, 4, 6, 8].map((d) => `<button data-act="measuredepth" data-id="${d}" class="${d === depth ? 'on' : ''}">Rock ${d} in</button>`).join('')}</div><p class="muted small">Loads figured at 10 yards a truck, before compaction. Yardage and loads has the full calculator.</p>` : '<p class="muted">A distance only. Give the drive a width to get square feet.</p>')}</div>
            ${sell && sq ? `<details class="card fold" ${S.adding ? 'open' : ''}><summary>Save this as a new lead</summary><form data-form="measurelead" class="grid2">${field('Customer name', 'name', 'text', 'required')}${field('Phone', 'phone', 'tel')}${field('Town or address', 'city', 'text', `value="${esc(m.address || '')}"`)}${field('Job (driveway, lot, road…)', 'job_type')}<div class="full"><button class="btn btn--paver">Save lead with this drawing</button></div></form></details>` : ''}` : ''}` };
    },
    async calc() {
      const n = (label: string, name: string, val: unknown = '') => field(label, name, 'text', `inputmode="decimal" value="${val}"`);
      return { eyebrow: 'Shop', title: 'Yardage and loads', sub: 'How much material to order and how many truckloads it takes.',
        body: `<div class="cols">${card('Cubic yards and loads', `<form data-form="calc-yard" class="grid2">${n('Length (ft)', 'length')}${n('Width (ft)', 'width')}${n('Or total square feet', 'sqft')}${n('Depth (inches)', 'depth', 4)}${n('Compaction %', 'compaction', 15)}${n('Yards per truckload', 'perLoad', 12)}</form><p class="price" data-out="yard">—</p><table class="lines"><tbody data-out="yardlines"></tbody></table><p class="muted small">Compaction is the extra loose material it takes to end up at that depth once it is packed. The Field guide lists it for each kind of rock.</p>`)}
          ${card('Hot mix: how many tons', `<form data-form="calc-mix" class="grid2">${n('Length (ft)', 'length')}${n('Width (ft)', 'width')}${n('Or total square feet', 'sqft')}${n('Thickness laid (inches)', 'inches', 2)}${n('Tons in one cubic yard', 'tpy', 2)}${n('Truck holds (tons)', 'truck', 15)}</form><p class="price" data-out="mix">—</p><p class="muted small" data-out="mixnote">Confirm the weight with your plant.</p>`)}</div>
          ${card('Yards to tons, tons to yards', `<div class="cols"><form data-form="calc-y2t" class="grid2">${n('Yards', 'yards')}${n('Tons in one yard of this material', 'tpy', 2)}</form><form data-form="calc-t2y" class="grid2">${n('Tons', 'tons')}${n('Yards in one ton of this material', 'ypt', 0.5)}</form></div><p class="price" data-out="conv">—</p>`)}` };
    },
    async account() {
      return { eyebrow: 'You', title: 'My account', sub: `${S.me.name} · ${S.me.email}`,
        body: `${card('This device', alertsBar() || '<p class="muted">This app is installed and alerts are set.</p>')}${card('Change my password', passwordForm())}${card('Sign out', '<button class="btn btn--line" data-act="logout">Sign out of this device</button>')}` };
    },
  };

  // ---------- the frame around every page ----------
  const allowed = (v: string) => NAV.some(([, items]) => items.some(([k, , roles]) => k === v && roles.includes(S.me.role)));
  const QUICK: Record<string, string[]> = { owner: ['home', 'jobs', 'schedule', 'pipeline', 'team'], manager: ['home', 'jobs', 'schedule', 'pipeline', 'team'], sales: ['home', 'jobs', 'schedule', 'pipeline', 'estimate'], crew: ['home', 'jobs', 'schedule', 'training', 'equipment'] };
  const SHORT: Record<string, string> = { home: 'Home', jobs: 'Jobs', schedule: 'Schedule', pipeline: 'Leads', team: 'Team', estimate: 'Estimate', training: 'Training', equipment: 'Equipment' };
  const tabbar = () => `<nav class="tabbar" aria-label="Quick access">${QUICK[S.me.role].map((k) => `<button class="tab ${S.view === k ? 'active' : ''}" data-go="${k}">${icon(k)}<span>${SHORT[k]}</span></button>`).join('')}<button class="tab ${QUICK[S.me.role].includes(S.view) ? '' : 'active'}" data-act="drawer">${icon('menu')}<span>More</span></button></nav>`;
  async function renderStaff() {
    if (!allowed(S.view)) S.view = 'home';
    const p = await PAGES[S.view]();
    const initials = (S.me.name || '?').split(' ').map((x: string) => x[0]).slice(0, 2).join('').toUpperCase();
    const side = NAV.map(([group, items]) => { const mine = items.filter(([, , roles]) => roles.includes(S.me.role)); return mine.length ? `<div><div class="side__group">${group}</div>${mine.map(([k, label]) => `<button class="nav ${S.view === k ? 'active' : ''}" data-go="${k}">${icon(k)}<span>${label}</span></button>`).join('')}</div>` : ''; }).join('');
    root.innerHTML = `<div class="shell ${S.drawer ? 'drawer-open' : ''}">
      <aside class="side"><a class="side__brand" href="/app/" data-go="home">${BRAND}</a>${side}<div class="side__foot"><b>CGH Operations</b><br />For a better future</div></aside>
      <button class="scrim" data-act="drawer" aria-label="Close menu"></button>
      <div class="main">
        <header class="top"><button class="iconbtn menu" data-act="drawer" aria-label="Menu">${icon('menu')}</button>
          ${S.me.role === 'crew' ? '<span class="top__title">CGH Operations</span>' : `<label class="search">${icon('search')}<input data-search type="search" placeholder="Search leads, customers, jobs…" value="${esc(S.q)}" aria-label="Search" /></label>`}
          <div class="top__right"><button class="iconbtn ${S.pushOn ? 'on' : ''}" data-go="account" aria-label="Alerts and account">${icon('bell')}</button><button class="avatar" data-go="account" aria-label="My account">${esc(initials)}</button></div></header>
        <main class="page"><div class="stack">${photoHead(S.view, p.eyebrow, p.title, p.sub, p.actions)}${notes()}${p.body}${verseFoot(S.view)}</div></main>
      </div>${tabbar()}</div>`;
    if (S.view === 'quote') quoteMath();
    if (S.view === 'estimate') estMath();
    if (S.view === 'matcost') matMath();
  }

  async function render() {
    const act = document.activeElement as HTMLElement | null; const searching = act?.matches?.('[data-gsearch]') ? '[data-gsearch]' : act?.matches?.('[data-search]') ? '[data-search]' : '';
    try {
      if (!S.me) renderAuth('login');
      else if (S.me.mustChange) renderAuth('first');
      else if (S.me.role === 'client') await renderClient();
      else await renderStaff();
    } catch (e: any) { root.innerHTML = `<div class="authwrap"><div class="auth"><p class="err">${esc(e.message)}</p><button class="btn btn--line" data-act="reload">Try again</button></div></div>`; }
    if (searching) { const i = root.querySelector<HTMLInputElement>(searching); if (i) { i.focus(); i.setSelectionRange(i.value.length, i.value.length); } }
  }
  const run = async (fn: () => Promise<void> | void) => {
    S.msg = ''; S.ok = ''; S.keep = false; try { await fn(); } catch (e: any) { S.msg = e.message; }
    // Saving defaults keeps the screen as it is (so typed numbers are not wiped) and just shows the message.
    if (S.keep && !S.msg) { S.keep = false; const head = root.querySelector('.photo-head'); root.querySelectorAll('.stack > .ok').forEach((e) => e.remove()); head?.insertAdjacentHTML('afterend', `<p class="ok" role="status">${esc(S.ok)}</p>`); return; }
    await render();
  };
  const go = (dest: string) => { const [view, a, b] = dest.split(':'); S.view = view; S.drawer = false; S.welcome = null; S.confirm = null; S.adding = a === 'add'; if (a === 'open') { S.open = b; S.filter = 'Open'; const l = (S.data?.leads || []).find((x: any) => x.id === b); if (l && ['Done', 'Lost'].includes(l.stage)) S.filter = l.stage; } else if (a && a !== 'add') S.filter = a; scrollTo(0, 0); };

  // ---------- live math on the Quick quote and calculator pages (no saving, no reload) ----------
  const area = (f: HTMLFormElement) => { const d = new FormData(f); return num(d.get('sqft')) || num(d.get('length')) * num(d.get('width')); };
  const fillWords = (n: number) => (n === 0 ? 'None' : n >= 100 ? 'All of it' : `About ${n}%`);
