---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title="Paving & Dirt Work Blog | East Texas Asphalt Advice" description="Straight answers about asphalt driveways, parking lots, base work and upkeep in East Texas from the crew at CGH Operations in Longview.">
  <section class="band pagehead">
    <div class="wrap">
      <ol class="crumbs"><li><a href="/">Home</a></li><li>Blog</li></ol>
      <h1>Straight answers about asphalt</h1>
      <p class="lede">What we tell customers on site visits, written down.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap list">
      {posts.map((p) => (
        <a class="row" href={`/blog/${p.id}`}>
          {p.data.image && <img src={p.data.image} alt={p.data.imageAlt ?? ''} loading="lazy" width="320" height="240" />}
          <div>
            <p class="muted">{p.data.category}, {fmt(p.data.date)}</p>
            <h2>{p.data.title}</h2>
            <p>{p.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .list { display: grid; }
  .row { display: grid; gap: 20px; padding: 28px 0; border-top: 1px solid var(--border-strong); text-decoration: none; align-items: center; }
  .row:first-child { border-top: 3px solid var(--asphalt); }
  @media (min-width: 720px) { .row { grid-template-columns: 260px 1fr; gap: 36px; } }
  .row img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-lg); }
  .row h2 { font-size: clamp(1.4rem, 2.6vw, 1.9rem); margin: 4px 0 8px; }
  .row p { margin: 0; max-width: 68ch; color: var(--text-2); }
  .row .muted { font-size: 0.92rem; color: var(--muted); }
  .row:hover h2 { text-decoration: underline; text-decoration-color: var(--paver); text-decoration-thickness: 4px; text-underline-offset: 5px; }
</style>
