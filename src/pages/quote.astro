---
import Base from '../layouts/Base.astro';
import QuoteTool from '../components/QuoteTool.astro';
import Strata from '../components/Strata.astro';
import { site } from '../data/site';
const faqs = [
  { q: 'How accurate is the online price?', a: 'It is a ballpark built from your measurements and what you tell us about the ground. Most jobs land inside the range. The site visit is where we confirm it, because drainage, soft spots and access are hard to judge from a form.' },
  { q: 'Is the site visit really free?', a: 'Yes. We come out, measure, look at the ground and give you a firm price. No charge and no pressure.' },
  { q: 'Why is there a minimum price?', a: 'Every paving job takes a crew, the paver, a roller and a truck of hot mix, no matter how small the area. The minimum covers getting all of that to your site.' },
  { q: 'Do I have to give my phone number to see a price?', a: 'No. You see your price range first. If it fits your budget and you want us to come look, you can leave a name and number then. If not, nothing is sent to us.' },
  { q: 'Can I get a price for a seal coat?', a: 'Yes. Pick Seal coat at the start. You see a range for each kind of sealer we put down, with how long each one lasts and how it works.' },
  { q: 'What about repairs, crack filling, striping or dirt work?', a: 'Those depend too much on what is there now to price from a form. Call us and we will come look at it.' },
];
const schema = [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }];
---
<Base title="Asphalt Paving and Seal Coat Cost | Instant Price Range" description="See a price range for new asphalt or a seal coat in about a minute. No name or phone number needed. Enter the size and a few details. Longview and East Texas." schema={schema}>
  <section class="band pagehead qhead" style="--pagehead-photo:url('/img/work/curved-asphalt-driveway-east-texas.webp')">
    <div class="wrap">
      <h1>Get your price range</h1>
      <p class="lede">See your price first. No name, phone or email needed unless you decide to send it in.</p>
    </div>
  </section>
  <section class="qbody">
    <div class="wrap narrow"><QuoteTool /></div>
  </section>
  <Strata heading="What goes into your price" />
  <section class="section">
    <div class="wrap narrow">
      <h2>Questions about pricing</h2>
      <div class="faq">{faqs.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}</div>
      <p class="muted" style="margin-top:28px">Prefer to talk? Call <a class="textlink" href={site.phoneHref}>{site.phone}</a>, {site.hours}.</p>
    </div>
  </section>
</Base>
<style>
  .qhead { padding-bottom: clamp(110px, 12vw, 150px); }
  .qbody { margin-top: clamp(-110px, -9vw, -80px); padding-bottom: var(--section); position: relative; }
</style>
