---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Strata from '../components/Strata.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, reviews, workPhotos } from '../data/site';
import { services, groups } from '../data/services';
import { areas } from '../data/areas';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const strip = workPhotos.slice(0, 6);
const steps = [
  { name: 'Get your price range', text: 'Enter the size of the job and what shape the ground is in. You see a price range in about a minute.' },
  { name: 'We come look at it', text: 'A free site visit confirms the number. We check drainage, soft spots and access, and tell you what the job really needs.' },
  { name: 'We prep and pave', text: 'We fix the base, lay hot mix with our own paver and roll it tight. Most driveways take a day or two.' },
  { name: 'You drive on it', text: 'We clean up and tell you exactly when it is ready for traffic.' },
];
---
<Base loader title="Asphalt Paving & Dirt Work in Longview, TX | CGH Operations" description="CGH Operations paves driveways, parking lots and private roads across East Texas and handles the dirt work under them. Based in Longview. Get a price range online in about a minute.">
  <section class="drive" data-drive>
    <div class="drive__pin hero band">
      <video class="hero__video" data-drive-video autoplay muted loop playsinline preload="auto" poster="/video/roller-on-new-driveway.webp" aria-hidden="true">
        <source src="/video/roller-scroll.mp4" type="video/mp4" />
      </video>
      <div class="hero__shade"></div>
      <div class="wrap hero__in drive__beat drive__beat--1">
        <div class="hero__copy">
          <h1>Asphalt paving and dirt work, done by one Longview crew.</h1>
          <p class="lede">Driveways, parking lots and private roads across East Texas. We own the paver, the dozer and the dump trucks, so the people who shape your ground are the same people who pave it.</p>
          <ul class="hero__facts">
            <li>Paving East Texas since {site.foundedYear}</li>
            <li>Homes, ranches, churches and businesses</li>
            <li>Free site visit before any work starts</li>
          </ul>
        </div>
        <form class="start" action="/quote" method="get">
          <h2>See your price in about a minute</h2>
          <p>Start with the size of the area you want paved.</p>
          <div class="start__row">
            <div class="field"><label for="st-len">Length (ft)</label><input id="st-len" name="length" inputmode="decimal" placeholder="100" /></div>
            <span aria-hidden="true">×</span>
            <div class="field"><label for="st-wid">Width (ft)</label><input id="st-wid" name="width" inputmode="decimal" placeholder="12" /></div>
          </div>
          <button class="btn btn--paver" type="submit">Get my price range</button>
          <p class="start__alt">Rather talk it through? <a href={site.phoneHref}>Call {site.phone}</a></p>
        </form>
      </div>
      <div class="wrap drive__beat drive__beat--2" aria-hidden="true">
        <p class="drive__big">From breaking ground</p>
      </div>
      <div class="wrap drive__beat drive__beat--3">
        <p class="drive__big">to groundbreaking.</p>
        <p class="drive__big drive__big--y">CGH brings results.</p>
        <a class="btn btn--paver" href="/quote">Get my price range</a>
      </div>
      <p class="drive__hint" aria-hidden="true">Scroll to drive the roller</p>
      <div class="stripe"></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head">
        <h2>Everything asphalt, and the ground under it</h2>
        <p class="lede">New pavement, upkeep that makes it last, and the dirt work that decides whether it holds up.</p>
      </div>
      <div class="svc">
        {groups.map((g) => (
          <div class="svc__col">
            <h3>{g}</h3>
            <ul>
              {services.filter((s) => s.group === g).map((s) => (
                <li><a href={`/services/${s.slug}`}><b>{s.name}</b><span>{s.line}</span></a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  {strip.length > 0 && (
    <section class="work">
      <div class="wrap head head--row">
        <h2>Recent work around East Texas</h2>
        <a class="textlink" href="/work">See more of our work</a>
      </div>
      <div class="work__rail">
        {strip.map((p) => (
          <figure><img src={p.src} alt={p.alt} loading="lazy" decoding="async" width="600" height="800" /><figcaption>{p.caption}</figcaption></figure>
        ))}
      </div>
    </section>
  )}

  <Strata />

  <section class="section">
    <div class="wrap">
      <div class="head"><h2>How a job goes</h2></div>
      <ol class="steps">
        {steps.map((s) => (<li><h3>{s.name}</h3><p>{s.text}</p></li>))}
      </ol>
    </div>
  </section>

  {reviews.length > 0 && (
    <section class="section section--stone">
      <div class="wrap">
        <div class="head"><h2>What customers say</h2></div>
        <div class="reviews">
          {reviews.slice(0, 3).map((r) => (
            <figure><blockquote>{r.quote}</blockquote><figcaption><b>{r.name}</b>{r.town && `, ${r.town}`}{r.job && <span>{r.job}</span>}</figcaption></figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section band about">
    <div class="wrap split">
      <div>
        <h2>A faith-driven crew that owns its work</h2>
        <p class="lede">CGH Operations started in Longview in {site.foundedYear}. We are a small crew with our own paver, roller, dozer, backhoe, skid steer and dump trucks. That means you deal with the people doing the work, and we answer for how it turns out.</p>
        <p class="verse">"{site.verse.text}" <span>{site.verse.ref}</span></p>
        <div class="btn-row"><a class="btn btn--line" href="/about">About CGH Operations</a><a class="btn btn--line" href="/careers">We are hiring</a></div>
      </div>
      <div>
        <h3>Where we work</h3>
        <ul class="towns">
          {areas.map((a) => <li><a href={`/service-areas/${a.slug}`}>{a.city}</a></li>)}
        </ul>
        <p class="muted">And across East Texas into Louisiana, Arkansas and Oklahoma for larger jobs.</p>
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="head head--row"><h2>From the blog</h2><a class="textlink" href="/blog">All posts</a></div>
        <div class="posts">
          {posts.map((p) => (
            <a class="post" href={`/blog/${p.id}`}>
              <span class="muted">{p.data.category}</span>
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand />
</Base>

<script>
  // Drive the roller: scrolling through the pinned hero scrubs the real roller video.
  const root = document.querySelector<HTMLElement>('[data-drive]');
  const video = root?.querySelector<HTMLVideoElement>('[data-drive-video]');
  const ok = root && video && !matchMedia('(prefers-reduced-motion: reduce)').matches && !matchMedia('(max-height: 540px)').matches;
  if (ok) {
    document.documentElement.classList.add('drive-on');
    video.removeAttribute('autoplay'); video.loop = false; video.pause();
    let target = 0, cur = 0, raf = 0;
    const tick = () => {
      raf = 0;
      cur += (target - cur) * 0.2;
      if (Math.abs(target - cur) < 0.0008) cur = target;
      if (video.duration) { const t = cur * (video.duration - 0.08); if (Math.abs(video.currentTime - t) > 0.02) video.currentTime = t; }
      if (cur !== target) raf = requestAnimationFrame(tick);
    };
    const measure = () => {
      const r = root.getBoundingClientRect();
      const span = r.height - innerHeight;
      const p = Math.min(1, Math.max(0, (68 - r.top) / span));
      root.style.setProperty('--p', p.toFixed(4));
      root.dataset.beat = p < 0.28 ? '1' : p < 0.68 ? '2' : '3';
      target = p;
      if (!raf) raf = requestAnimationFrame(tick);
    };
    addEventListener('scroll', measure, { passive: true });
    addEventListener('resize', measure);
    video.addEventListener('loadedmetadata', measure);
    // phones only let a video be scrubbed after it has been started once by a touch
    addEventListener('touchstart', () => { video.play().then(() => video.pause()).catch(() => {}); }, { once: true, passive: true });
    measure();
  }
</script>

<style>
  .hero { position: relative; overflow: hidden; }
  .hero__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero__shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(20, 21, 23, 0.94) 0%, rgba(20, 21, 23, 0.82) 42%, rgba(20, 21, 23, 0.5) 100%), linear-gradient(0deg, rgba(20, 21, 23, 0.7), transparent 40%); }
  .hero__in { position: relative; display: grid; gap: 40px; padding-top: clamp(56px, 8vw, 110px); padding-bottom: clamp(56px, 8vw, 110px); align-items: center; }
  @media (min-width: 980px) { .hero__in { grid-template-columns: 1.25fr 0.75fr; gap: 64px; } }
  .hero h1 { max-width: 15ch; }
  .hero .lede { color: #e4e1d8; }
  .hero__facts { list-style: none; padding: 0; margin: 28px 0 0; display: grid; gap: 8px; color: #e4e1d8; font-weight: 500; }
  .hero__facts li { padding-left: 22px; position: relative; }
  .hero__facts li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 12px; height: 4px; background: var(--paver); }
  .hero .stripe { position: absolute; left: 0; right: 0; bottom: 0; }

  /* "Drive the roller": the hero stays pinned while the visitor scrolls, and the scroll position
     sets how far the real roller video has played. Turned on by the script at the bottom of this
     file (class drive-on). Without it, this is a normal hero with the video looping. */
  .drive { --p: 0; }
  .drive__pin { display: grid; align-items: center; }
  .drive__pin > .drive__beat { grid-area: 1 / 1; position: relative; }
  .drive__beat--2, .drive__beat--3, .drive__hint { display: none; }
  .drive__big { margin: 0; font-family: var(--font-display); font-weight: 900; letter-spacing: -0.03em; line-height: 0.98; font-size: clamp(2.6rem, 8.4vw, 7rem); color: #fff; text-shadow: 0 2px 30px rgba(0, 0, 0, 0.55); max-width: 12ch; }
  .drive__big--y { color: var(--paver); max-width: none; font-size: clamp(1.8rem, 5vw, 4rem); margin: 10px 0 26px; }

  :global(html.drive-on) .drive { height: 320vh; }
  :global(html.drive-on) .drive__pin { position: sticky; top: 68px; height: calc(100svh - 68px); }
  :global(html.drive-on) .drive__beat--2, :global(html.drive-on) .drive__beat--3 { display: block; align-self: end; padding-bottom: clamp(56px, 10vh, 110px); pointer-events: none; }
  :global(html.drive-on) .drive__beat--1 { opacity: clamp(0, calc((0.26 - var(--p)) * 9), 1); padding-top: 24px; padding-bottom: 24px; }
  :global(html.drive-on) .drive__beat--2 { opacity: clamp(0, min(calc((var(--p) - 0.3) * 10), calc((0.66 - var(--p)) * 12)), 1); }
  :global(html.drive-on) .drive__beat--3 { opacity: clamp(0, calc((var(--p) - 0.7) * 10), 1); }
  :global(html.drive-on) .drive[data-beat='1'] .drive__beat--1, :global(html.drive-on) .drive[data-beat='3'] .drive__beat--3 { pointer-events: auto; }
  :global(html.drive-on) .drive:not([data-beat='1']) .drive__beat--1 { pointer-events: none; }
  :global(html.drive-on) .hero__shade { opacity: max(0.42, calc(1 - var(--p) * 2.4)); }
  :global(html.drive-on) .drive__hint { display: block; position: absolute; left: 0; right: 0; bottom: 22px; margin: 0; text-align: center; font-weight: 600; font-size: 0.92rem; color: #fff; opacity: clamp(0, calc((0.12 - var(--p)) * 12), 0.9); }
  :global(html.drive-on) .drive__hint::after { content: ''; display: block; width: 2px; height: 22px; margin: 8px auto 0; background: var(--paver); animation: drive-nudge 1.4s ease-in-out infinite; }
  @keyframes drive-nudge { 0%, 100% { transform: translateY(0); opacity: 1; } 50% { transform: translateY(8px); opacity: 0.4; } }
  @media (max-width: 979px) {
    :global(html.drive-on) .hero__copy .lede, :global(html.drive-on) .hero__facts { display: none; }
    :global(html.drive-on) .hero__in { gap: 20px; }
    :global(html.drive-on) .hero h1 { font-size: clamp(2rem, 8.6vw, 2.6rem); margin-bottom: 0; }
    :global(html.drive-on) .drive__pin { height: calc(100svh - 68px - 56px); }
    :global(html.drive-on) .drive__hint { bottom: 14px; }
  }

  .start { background: var(--chalk); color: var(--asphalt); border-radius: var(--radius-lg); padding: clamp(22px, 3vw, 32px); --text: var(--asphalt); --surface: #fff; --border-strong: rgba(27, 28, 30, 0.28); --muted: #5f6368; box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45); }
  .start h2 { font-size: 1.6rem; margin-bottom: 6px; }
  .start p { margin: 0 0 18px; color: #3a3d41; }
  .start__row { display: grid; grid-template-columns: 1fr auto 1fr; gap: 10px; align-items: end; margin-bottom: 16px; }
  .start__row span { padding-bottom: 12px; color: #5f6368; font-size: 1.2rem; }
  .start .btn { width: 100%; }
  .start .start__alt { margin: 14px 0 0; font-size: 0.95rem; text-align: center; }
  .start__alt a { font-weight: 700; color: var(--clay); }

  .head { margin-bottom: clamp(28px, 4vw, 48px); }
  .head h2 { max-width: 20ch; }
  .head--row { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px 24px; }
  .head--row h2 { margin: 0; }

  .svc { display: grid; gap: 36px; }
  @media (min-width: 900px) { .svc { grid-template-columns: repeat(3, 1fr); gap: 48px; } }
  .svc__col h3 { font-size: 1rem; font-weight: 800; color: var(--clay); padding-bottom: 12px; border-bottom: 3px solid var(--asphalt); margin: 0; }
  .svc ul { list-style: none; padding: 0; margin: 0; }
  .svc li a { display: block; padding: 18px 0; border-bottom: 1px solid var(--border-strong); text-decoration: none; }
  .svc li b { display: block; font-family: var(--font-display); font-weight: 800; font-size: 1.3rem; letter-spacing: -0.01em; }
  .svc li span { color: var(--muted); font-size: 0.98rem; }
  .svc li a:hover b { text-decoration: underline; text-decoration-color: var(--paver); text-decoration-thickness: 4px; text-underline-offset: 5px; }

  .work { padding-bottom: var(--section); }
  .work__rail { display: flex; gap: 14px; overflow-x: auto; padding: 0 max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter))) 14px; scroll-padding-left: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter))); scroll-snap-type: x proximity; scrollbar-width: thin; }
  .work__rail figure { margin: 0; flex: 0 0 min(72vw, 330px); scroll-snap-align: start; }
  .work__rail img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; border-radius: var(--radius-lg); background: var(--limestone-2); }
  .work__rail figcaption { margin-top: 10px; font-weight: 600; font-size: 0.95rem; }

  .steps { list-style: none; counter-reset: step; padding: 0; margin: 0; display: grid; gap: 28px; }
  @media (min-width: 760px) { .steps { grid-template-columns: repeat(2, 1fr); gap: 40px 56px; } }
  @media (min-width: 1100px) { .steps { grid-template-columns: repeat(4, 1fr); } }
  .steps li { counter-increment: step; border-top: 3px solid var(--asphalt); padding-top: 18px; }
  .steps li::before { content: counter(step); display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: var(--paver); font-family: var(--font-display); font-weight: 900; margin-bottom: 14px; }
  .steps p { color: var(--text-2); margin: 0; }

  .reviews { display: grid; gap: 24px; }
  @media (min-width: 900px) { .reviews { grid-template-columns: repeat(3, 1fr); } }
  .reviews figure { margin: 0; background: var(--surface); border-radius: var(--radius-lg); padding: 28px; }
  .reviews blockquote { margin: 0 0 16px; font-size: 1.08rem; }
  .reviews figcaption span { display: block; color: var(--muted); font-size: 0.92rem; }

  .about .lede { color: var(--text-2); }
  .verse { border-left: 4px solid var(--paver); padding-left: 18px; font-size: 1.1rem; max-width: 46ch; margin: 28px 0; }
  .verse span { display: block; color: var(--muted); font-size: 0.95rem; margin-top: 4px; }
  .towns { list-style: none; padding: 0; margin: 0 0 18px; display: grid; grid-template-columns: 1fr 1fr; gap: 0 28px; }
  .towns a { display: block; padding: 11px 0; border-bottom: 1px solid var(--border); text-decoration: none; font-family: var(--font-display); font-weight: 700; font-size: 1.12rem; }
  .towns a:hover { color: var(--paver); }

  .posts { display: grid; gap: 24px; }
  @media (min-width: 900px) { .posts { grid-template-columns: repeat(3, 1fr); gap: 36px; } }
  .post { text-decoration: none; border-top: 3px solid var(--asphalt); padding-top: 16px; display: block; }
  .post h3 { margin: 6px 0 8px; font-size: 1.35rem; }
  .post p { color: var(--text-2); margin: 0; }
  .post:hover h3 { text-decoration: underline; text-decoration-color: var(--paver); text-decoration-thickness: 4px; text-underline-offset: 5px; }
</style>
