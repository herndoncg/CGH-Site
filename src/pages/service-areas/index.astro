---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import StatesMap from '../../components/StatesMap.astro';
import { areas } from '../../data/areas';
import { site } from '../../data/site';
const states = ['Texas', 'Arkansas', 'Oklahoma', 'Louisiana'];
---
<Base title="Where We Work: Texas, Arkansas, Oklahoma and Louisiana" description="CGH Operations paves and does dirt work in Texas, Arkansas, Oklahoma and Louisiana. Based in Longview and Texarkana, Texas. Started in Longview.">
  <section class="band pagehead" style="--pagehead-photo:url('/img/work/ranch-entrance-asphalt-drive.webp')">
    <div class="wrap">
      <ol class="crumbs"><li><a href="/">Home</a></li><li>Service areas</li></ol>
      <h1>Where we work</h1>
      <p class="lede">Texas, Arkansas, Oklahoma and Louisiana.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap where">
      <StatesMap />
      <div class="where__side">
        <ul class="states">
          {states.map((s) => <li>{s}</li>)}
        </ul>
        <div class="bases">
          <article class="base base--home">
            <p>Home base. Where we started in {site.foundedYear}.</p>
            <h2>Longview, Texas</h2>
          </article>
          <article class="base">
            <p>Second base</p>
            <h2>Texarkana, Texas</h2>
          </article>
        </div>
        <p class="where__note">Not sure if we come to you? We travel for the right job. Call and tell us where it is.</p>
        <div class="btn-row">
          <a class="btn btn--dark" href="/quote">Get my price range</a>
          <a class="btn btn--line" href={site.phoneHref}>Call {site.phone}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--stone">
    <div class="wrap">
      <h2 class="towns__head">East Texas towns we are in most</h2>
      <ul class="alist">
        {areas.map((a) => (<li><a href={`/service-areas/${a.slug}`}><b>{a.city}</b><span>{a.drive.replace('About ', '').replace(' from our yard', ' away')}</span></a></li>))}
      </ul>
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .where { display: grid; gap: clamp(24px, 5vw, 64px); align-items: center; }
  @media (min-width: 900px) { .where { grid-template-columns: 1.15fr 0.85fr; } }

  .states { list-style: none; margin: 0 0 28px; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 6px 24px; }
  .states li { font-family: var(--font-display); font-weight: 900; font-size: clamp(1.7rem, 3.6vw, 2.6rem); letter-spacing: -0.02em; line-height: 1.1; }

  .bases { display: grid; gap: 12px; }
  .base { margin: 0; padding: 16px 18px; background: var(--white); border-left: 6px solid var(--limestone-2); border-radius: var(--radius); }
  .base--home { border-left-color: var(--clay); }
  .base p { margin: 0 0 2px; color: var(--muted); font-weight: 600; font-size: 0.98rem; }
  .base h2 { margin: 0; font-size: 1.6rem; }
  .where__note { margin: 22px 0 18px; color: var(--text-2); }

  .towns__head { margin: 0 0 22px; font-size: clamp(1.5rem, 3vw, 2.1rem); }
  .alist { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0 24px; border-top: 3px solid var(--asphalt); }
  @media (min-width: 800px) { .alist { grid-template-columns: repeat(4, 1fr); } }
  .alist a { display: block; padding: 14px 0; border-bottom: 1px solid var(--border-strong); text-decoration: none; }
  .alist b { display: block; font-family: var(--font-display); font-weight: 800; font-size: 1.2rem; }
  .alist span { color: var(--muted); font-size: 0.9rem; }
  .alist a:hover b { text-decoration: underline; text-decoration-color: var(--paver); text-decoration-thickness: 3px; text-underline-offset: 4px; }
</style>
