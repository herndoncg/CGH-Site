---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { areas } from '../../data/areas';
---
<Base title="Service Areas: Asphalt Paving Across East Texas" description="CGH Operations paves driveways, parking lots and private roads in Longview, Texarkana, Kilgore, Tyler, Marshall, Henderson, Gilmer, Hallsville, White Oak, Gladewater, Carthage and across East Texas.">
  <section class="band pagehead">
    <div class="wrap">
      <ol class="crumbs"><li><a href="/">Home</a></li><li>Service areas</li></ol>
      <h1>Where we pave</h1>
      <p class="lede">Based out of Longview and Texarkana, Texas. We work across East Texas and the Ark-La-Tex: Texas, Louisiana, Arkansas and Oklahoma.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <ul class="alist">
        {areas.map((a) => (<li><a href={`/service-areas/${a.slug}`}><h2>{a.city}, TX</h2><p>{a.county}</p><span>{a.drive}</span></a></li>))}
      </ul>
      <p class="lede" style="margin-top:36px">Not on the list? We probably still come to you. Call and ask.</p>
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .alist { list-style: none; padding: 0; margin: 0; display: grid; gap: 0 48px; border-top: 3px solid var(--asphalt); }
  @media (min-width: 700px) { .alist { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1050px) { .alist { grid-template-columns: 1fr 1fr 1fr; } }
  .alist a { display: block; padding: 22px 0; border-bottom: 1px solid var(--border-strong); text-decoration: none; }
  .alist h2 { font-size: 1.5rem; margin: 0 0 2px; }
  .alist p { margin: 0; color: var(--text-2); }
  .alist span { color: var(--muted); font-size: 0.92rem; }
  .alist a:hover h2 { text-decoration: underline; text-decoration-color: var(--paver); text-decoration-thickness: 4px; text-underline-offset: 5px; }
</style>
