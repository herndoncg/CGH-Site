---
import '@fontsource-variable/overpass';
import '@fontsource-variable/instrument-sans';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { areas } from '../data/areas';
import { services } from '../data/services';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  /** The signed-in app: no public header, footer or call bar, and the dark app background. */
  bare?: boolean;
}

const { title, description: rawDescription, image = '/og-default.png', type = 'website', schema = [], noindex = false, bare = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', site.url).href;
// Google shows about 60 characters of a title and 155 of a description.
const fullTitle = title.includes('CGH') ? title : `${title} | CGH Operations`;
const clip = (s: string, n: number) => (s.length <= n ? s : s.slice(0, s.lastIndexOf(' ', n - 1)).replace(/[,;:.\s]+$/, '') + '.');
const description = clip(rawDescription, 158);
const ogImage = new URL(image, site.url).href;

const business: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  '@id': `${site.url}/#business`,
  name: site.name,
  legalName: site.legalName,
  description: 'Asphalt paving and dirt work contractor based in Longview and Texarkana, Texas, serving Texas, Louisiana, Arkansas and Oklahoma: driveways, parking lots, private roads, overlays, repairs, sealcoating, striping, road base and grading.',
  url: site.url,
  telephone: site.phoneSchema,
  image: ogImage,
  foundingDate: String(site.foundedYear),
  address: { '@type': 'PostalAddress', addressLocality: site.city, addressRegion: site.state, addressCountry: 'US', ...(site.postalCode ? { postalCode: site.postalCode } : {}) },
  areaServed: [
    ...areas.map((a) => ({ '@type': 'City', name: `${a.city}, TX` })),
    ...site.statesServed.map((s) => ({ '@type': 'State', name: s })),
  ],
  openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'], opens: '08:00', closes: '18:00' }],
  hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Asphalt and dirt work services', itemListElement: services.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.name, url: `${site.url}/services/${s.slug}` } })) },
  sameAs: Object.values(site.social).filter(Boolean),
};
if (site.email) business.email = site.email;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content={bare ? 'width=device-width, initial-scale=1' : 'width=device-width, initial-scale=0.9'} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0b1220" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/white-cgh-favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/white-cgh-favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="CGH" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body class={bare ? 'band is-app' : undefined}>
    {bare ? <slot /> : (
      <Fragment>
        <a class="skip" href="#main">Skip to content</a>
        <Header />
        <main id="main"><slot /></main>
        <Footer />
        <nav class="callbar" aria-label="Quick contact">
          <button type="button" class="callbar__menu" data-menu-toggle aria-label="Open the menu"><span aria-hidden="true"></span>Menu</button>
          <a href={site.phoneHref} class="callbar__call">Call</a>
          {!Astro.url.pathname.startsWith('/quote') && <a href="/quote" class="callbar__quote">Get my price</a>}
        </nav>
        <script is:inline>
          // The Menu button in the bottom bar opens and closes the same menu as the three lines up top.
          (function () {
            var menu = document.querySelector('details.menu'), btn = document.querySelector('[data-menu-toggle]');
            if (!menu || !btn) return;
            btn.addEventListener('click', function () { menu.open = !menu.open; });
            menu.addEventListener('toggle', function () { btn.classList.toggle('is-open', menu.open); btn.lastChild.textContent = menu.open ? 'Close' : 'Menu'; });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape') menu.open = false; });
          })();
        </script>
      </Fragment>
    )}

    <style>
      .callbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 90; display: none; padding-bottom: env(safe-area-inset-bottom); background: var(--asphalt); box-shadow: 0 -6px 24px rgba(0, 0, 0, 0.18); border-top: 1px solid rgba(255, 255, 255, 0.1); }
      /* Solid navy carries on below the bar. Newer iPhones float their address bar over the page, and the
         page used to show through the gap under these buttons. */
      .callbar::after { content: ''; position: absolute; left: 0; right: 0; top: calc(100% - 1px); height: 240px; background: var(--asphalt); }
      .callbar a, .callbar button { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 56px; flex: 1 1 0; font-family: var(--font-display); font-weight: 800; font-size: 1.05rem; text-decoration: none; background: var(--asphalt); color: #fff; border: 0; cursor: pointer; }
      .callbar .callbar__menu { flex-grow: 0.8; } .callbar .callbar__quote { flex-grow: 1.3; }
      .callbar__call { border-left: 1px solid rgba(255, 255, 255, 0.12); }
      .callbar__menu span { width: 18px; height: 12px; border-top: 2px solid #fff; border-bottom: 2px solid #fff; position: relative; }
      .callbar__menu span::after { content: ''; position: absolute; left: 0; right: 0; top: 3px; border-top: 2px solid #fff; }
      .callbar__menu.is-open { color: var(--paver-bright); }
      .callbar .callbar__quote { background: var(--paver); color: var(--asphalt); }
      @media (max-width: 860px) {
        .callbar { display: flex; }
        /* (the footer leaves room for this bar; see Footer.astro) */
      }
    </style>
  </body>
</html>
